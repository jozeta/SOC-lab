#cloud-config
hostname: mgmt
manage_etc_hosts: false
package_update: true
package_upgrade: true     # start patched; deploy-soc-lab.sh reboots if an update needs it

ssh_authorized_keys: __ANSIBLE_KEYS__   # [] without ansible-ctrl

write_files:
  - path: /root/provision.sh
    permissions: '0o755'   # explicit octal: Multipass turns '0755' into the integer 493, which fails cloud-init's schema
    content: |
      #!/bin/bash
      set -euo pipefail
      lab_step() {   # progress for deploy-soc-lab.sh's panel: "<n> <what>" in /run/lab-progress
          LAB_STEP=$((${LAB_STEP:-0} + 1))
          printf '%s %s\n' "${LAB_STEP}" "$*" > /run/lab-progress
          echo "== step ${LAB_STEP}: $*"
      }
      export DEBIAN_FRONTEND=noninteractive
      WAZUH_MANAGER="__WAZUH_MANAGER_IP__"

      ADMIN_PASS="__ADMIN_PASS__"

      hostnamectl set-hostname mgmt

      apt-get update -y
      lab_step "Installing Docker"
      apt-get install -y docker.io
      systemctl enable --now docker

      # --- Uptime Kuma: status dashboard for the lab's own VMs/services ---
      lab_step "Starting Uptime Kuma"
      docker run -d --name uptime-kuma --restart unless-stopped \
          -p 3001:3001 -v uptime-kuma:/app/data \
          louislam/uptime-kuma:1

      # --- Semaphore UI: web UI on top of Ansible. Uses a file-based SQLite
      #     DB rather than standing up Postgres/MySQL just for a lab (newer
      #     Semaphore releases dropped the old BoltDB backend). Pinned
      #     version: `latest` broke this once already. It manages its own
      #     Ansible install inside the container -- it does not share
      #     ansible-ctrl's inventory/keys automatically; add the lab's SSH
      #     key and hosts through its web UI after login. ---
      lab_step "Starting Semaphore"
      mkdir -p /opt/semaphore-data /opt/semaphore-config
      chown 1001:0 /opt/semaphore-data /opt/semaphore-config   # the container's user
      docker run -d --name semaphore --restart unless-stopped \
          -p 3000:3000 \
          -e SEMAPHORE_DB_DIALECT=sqlite \
          -e SEMAPHORE_ADMIN=admin \
          -e SEMAPHORE_ADMIN_PASSWORD="${ADMIN_PASS}" \
          -e SEMAPHORE_ADMIN_NAME=Administrator \
          -e SEMAPHORE_ADMIN_EMAIL=admin@lab.local \
          -v /opt/semaphore-data:/var/lib/semaphore \
          -v /opt/semaphore-config:/etc/semaphore \
          semaphoreui/semaphore:v2.19.17

      # --- Kuma and Semaphore log to stdout: copy them to files for the Wazuh agent ---
      lab_step "Shipping the app logs"
      mkdir -p /var/log/lab-apps
      cat > /etc/systemd/system/lab-container-log@.service <<'EOC'
      [Unit]
      Description=Copy the %i container's log to /var/log/lab-apps/%i.log
      After=docker.service
      Requires=docker.service

      [Service]
      # sed drops logrus' leading time="...": Wazuh adds its own timestamp, and with
      # it Wazuh's aws-eks-authenticator decoder would claim every Semaphore line.
      ExecStart=/bin/sh -c 'docker logs -f --since 0s %i 2>&1 | sed -u "s/^time=[^ ]* //" >> /var/log/lab-apps/%i.log'
      Restart=always
      RestartSec=10

      [Install]
      WantedBy=multi-user.target
      EOC
      cat > /etc/logrotate.d/lab-apps <<'EOC'
      /var/log/lab-apps/*.log {
          weekly
          rotate 4
          compress
          missingok
          copytruncate
      }
      EOC
      systemctl daemon-reload
      systemctl enable --now lab-container-log@uptime-kuma lab-container-log@semaphore
      # --- Wazuh agent: Uptime Kuma logins and monitor failures, Semaphore task results ---
      if [ -n "${WAZUH_MANAGER}" ]; then
          lab_step "Installing the Wazuh agent"
          # Wazuh's package signing key, imported only if it is that key (fingerprint as pinned in
          # Wazuh's own installer, wazuh-installation-assistant).
          curl -fsSL --retry 5 --retry-delay 10 -o /tmp/wazuh.key https://packages.wazuh.com/key/GPG-KEY-WAZUH
          [ "$(gpg --show-keys --with-colons /tmp/wazuh.key | awk -F: '$1 == "fpr" { print $10; exit }')" = 0DCFCA5547B19D2A6099506096B3EE5F29111145 ]
          gpg --no-default-keyring --keyring gnupg-ring:/usr/share/keyrings/wazuh.gpg --import /tmp/wazuh.key
          rm -f /tmp/wazuh.key
          chmod 644 /usr/share/keyrings/wazuh.gpg
          echo "deb [signed-by=/usr/share/keyrings/wazuh.gpg] https://packages.wazuh.com/4.x/apt/ stable main" > /etc/apt/sources.list.d/wazuh.list
          apt-get update -y
          WAZUH_MANAGER="${WAZUH_MANAGER}" apt-get install -y wazuh-agent
          cat >> /var/ossec/etc/ossec.conf <<'EOF'

      <!-- SOC-lab: app logs (Uptime Kuma, Semaphore) -->
      <ossec_config>
        <localfile>
          <log_format>syslog</log_format>
          <location>/var/log/lab-apps/uptime-kuma.log</location>
        </localfile>
        <localfile>
          <log_format>syslog</log_format>
          <location>/var/log/lab-apps/semaphore.log</location>
        </localfile>
      </ossec_config>
      EOF
          systemctl daemon-reload
          systemctl enable --now wazuh-agent
      else
          echo "No siem in this lab: Wazuh agent not installed."
      fi

      echo "=================================================================="
      echo "Uptime Kuma : http://<this-vm-ip>:3001  (admin account and monitors: deploy test-data stage)"
      echo "Semaphore UI: http://<this-vm-ip>:3000  (user: admin / pass: the lab admin password)"
      echo "=================================================================="

runcmd:
  - /root/provision.sh > /var/log/provision.log 2>&1
