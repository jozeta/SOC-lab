#cloud-config
hostname: fs01
manage_etc_hosts: false
package_update: true
package_upgrade: true     # start patched; deploy-soc-lab.sh reboots if an update needs it

ssh_authorized_keys:
  - __ANSIBLE_PUBKEY__

write_files:
  - path: /root/provision.sh
    permissions: '0o755'   # explicit octal: Multipass turns '0755' into the integer 493, which fails cloud-init's schema
    content: |
      #!/bin/bash
      set -euo pipefail
      export DEBIAN_FRONTEND=noninteractive

      DOMAIN_REALM="__DOMAIN_REALM__"
      DOMAIN_NETBIOS="__DOMAIN_NETBIOS__"
      DC_IP="__DC_IP__"
      ADMIN_PASS="__ADMIN_PASS__"
      WAZUH_MANAGER="__WAZUH_MANAGER_IP__"

      hostnamectl set-hostname fs01

      # Point DNS at the DC so kerberos/AD lookups resolve correctly
      IFACE=$(ip -o -4 route show default | awk '{print $5; exit}')
      # Give this box a resolvable FQDN (as dc01 does). Without it the join
      # can't work out its DNS name and skips registering itself in AD DNS
      # ("No DNS domain configured ... Unable to perform DNS Update").
      MY_IP=$(ip -o -4 addr show dev "${IFACE}" | awk '{split($4,a,"/"); print a[1]; exit}')
      echo "${MY_IP} fs01.${DOMAIN_REALM,,} fs01" >> /etc/hosts
      # Point this box's DNS at the DC for the AD domain, persistently: a
      # systemd-resolved drop-in survives reboots and DHCP renewals. (The old
      # netplan drop-in + per-link `resolvectl` override was lost on reboot.)
      mkdir -p /etc/systemd/resolved.conf.d
      cat > /etc/systemd/resolved.conf.d/lab-dns.conf <<EOF
      [Resolve]
      DNS=${DC_IP}
      Domains=${DOMAIN_REALM,,}
      EOF
      systemctl restart systemd-resolved
      resolvectl flush-caches 2>/dev/null || true

      apt-get update -y
      apt-get install -y chrony samba winbind libnss-winbind libpam-winbind krb5-user dnsutils

      systemctl enable --now chrony

      cat > /etc/krb5.conf <<EOF
      [libdefaults]
          default_realm = ${DOMAIN_REALM}
          dns_lookup_realm = false
          dns_lookup_kdc = true
      EOF

      # `net ads join`'s failure message on discovery problems is a generic
      # RPC error that doesn't say why discovery failed -- verify the domain's
      # DNS SRV records actually resolve first and fail with real diagnostics
      # if they don't, instead of chasing that opaque error blind.
      SRV_OK=""
      for i in $(seq 1 12); do
          resolvectl flush-caches 2>/dev/null || true
          if host -t SRV "_ldap._tcp.${DOMAIN_REALM,,}" >/dev/null 2>&1; then
              SRV_OK="yes"
              break
          fi
          echo "Waiting for DNS (${DC_IP}) to serve ${DOMAIN_REALM,,} SRV records... (${i}/12)"
          sleep 5
      done
      if [ -z "${SRV_OK}" ]; then
          echo "ERROR: cannot resolve _ldap._tcp.${DOMAIN_REALM,,} SRV records."
          echo "--- /etc/resolv.conf ---"; cat /etc/resolv.conf
          echo "--- resolvectl status ---"; resolvectl status || true
          echo "--- direct query against DC ---"; host -t SRV "_ldap._tcp.${DOMAIN_REALM,,}" "${DC_IP}" || true
          exit 1
      fi

      # NOTE ON DESIGN: fs01 joins via classic winbind (net ads join) rather
      # than realmd/sssd. Mixing sssd and Samba's own winbind idmap on the
      # same box for AD-authenticated file shares is a common source of
      # nsswitch conflicts, so winbind-only keeps this member server
      # internally consistent. Plain login-only boxes (client01/client02)
      # use realmd/sssd instead -- see their provisioning script.
      mkdir -p /srv/shares/public /srv/shares/finance
      chmod 1777 /srv/shares/public
      chmod 770 /srv/shares/finance

      cat > /etc/samba/smb.conf <<EOF
      [global]
         workgroup = ${DOMAIN_NETBIOS}
         realm = ${DOMAIN_REALM}
         security = ads
         winbind use default domain = yes
         winbind enum users = yes
         winbind enum groups = yes
         idmap config * : backend = tdb
         idmap config * : range = 3000-7999
         idmap config ${DOMAIN_NETBIOS} : backend = rid
         idmap config ${DOMAIN_NETBIOS} : range = 200000-2147483999

      [public]
         path = /srv/shares/public
         read only = no
         browseable = yes

      [finance]
         path = /srv/shares/finance
         read only = no
         browseable = yes
         valid users = "@${DOMAIN_NETBIOS}\\Finance", "@${DOMAIN_NETBIOS}\\Domain Admins"
      EOF

      echo "${ADMIN_PASS}" | net ads join -U administrator

      # Make sure fs01 has an A record in AD DNS (needed for \\fs01.<realm>
      # and Kerberos to the shares). The join usually registers it now that
      # the FQDN resolves; register explicitly if it didn't.
      DNS_OK=""
      for i in $(seq 1 6); do
          if host "fs01.${DOMAIN_REALM,,}" "${DC_IP}" 2>/dev/null | grep -q "has address ${MY_IP}"; then
              DNS_OK="yes"; break
          fi
          echo "${ADMIN_PASS}" | net ads dns register -U administrator "fs01.${DOMAIN_REALM,,}" "${MY_IP}" || true
          sleep 5
      done
      if [ -z "${DNS_OK}" ]; then
          echo "ERROR: fs01.${DOMAIN_REALM,,} -> ${MY_IP} not registered in AD DNS."
          host "fs01.${DOMAIN_REALM,,}" "${DC_IP}" || true
      fi

      # Keep the record current if fs01's DHCP address changes: re-register
      # after every boot and daily. Uses fs01's machine account (-P), so no
      # admin credentials are stored here. (Clients do this through sssd's
      # dynamic DNS instead.)
      cat > /etc/systemd/system/lab-dns-register.service <<'EOC'
      [Unit]
      Description=Re-register this host's address in AD DNS
      After=network-online.target winbind.service
      Wants=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/usr/bin/net ads dns register -P
      EOC
      cat > /etc/systemd/system/lab-dns-register.timer <<'EOC'
      [Unit]
      Description=Refresh this host's AD DNS record after boot and daily

      [Timer]
      OnBootSec=2min
      OnUnitActiveSec=1d

      [Install]
      WantedBy=timers.target
      EOC
      systemctl daemon-reload
      systemctl enable --now lab-dns-register.timer

      sed -i 's/^passwd:.*/passwd:         files systemd winbind/' /etc/nsswitch.conf
      sed -i 's/^group:.*/group:          files systemd winbind/' /etc/nsswitch.conf
      pam-auth-update --enable winbind --enable mkhomedir

      systemctl restart smbd nmbd winbind
      systemctl enable smbd nmbd winbind

      # Group ownership depends on winbind resolving the AD group, and winbind
      # needs a moment after the restart above before the trust and group
      # lookups work. Wait for both instead of racing it; if they never come
      # up, finish the rest of provisioning (Wazuh agent) but fail at the end
      # so cloud-init reports an error rather than a silently half-set share.
      FINANCE_OK=""
      for i in $(seq 1 24); do
          if wbinfo -t >/dev/null 2>&1 && getent group "${DOMAIN_NETBIOS}\\Finance" >/dev/null; then
              chgrp "${DOMAIN_NETBIOS}\\Finance" /srv/shares/finance && FINANCE_OK="yes"
              break
          fi
          echo "Waiting for winbind to resolve ${DOMAIN_NETBIOS}\\Finance... (${i}/24)"
          sleep 5
      done
      if [ -z "${FINANCE_OK}" ]; then
          echo "ERROR: could not set /srv/shares/finance group to ${DOMAIN_NETBIOS}\\Finance."
          echo "--- wbinfo -t ---"; wbinfo -t || true
          echo "--- wbinfo -g ---"; wbinfo -g || true
      fi

      # --- Wazuh agent: ships auth/file-access telemetry to the SIEM ---
      curl -s https://packages.wazuh.com/key/GPG-KEY-WAZUH | gpg --no-default-keyring --keyring gnupg-ring:/usr/share/keyrings/wazuh.gpg --import
      chmod 644 /usr/share/keyrings/wazuh.gpg
      echo "deb [signed-by=/usr/share/keyrings/wazuh.gpg] https://packages.wazuh.com/4.x/apt/ stable main" > /etc/apt/sources.list.d/wazuh.list
      apt-get update -y
      WAZUH_MANAGER="${WAZUH_MANAGER}" apt-get install -y wazuh-agent
      systemctl daemon-reload
      systemctl enable --now wazuh-agent

      if [ -z "${FINANCE_OK}" ] || [ -z "${DNS_OK}" ]; then
          echo "fs01 provisioning finished WITH ERRORS (finance group: ${FINANCE_OK:-FAILED}, DNS record: ${DNS_OK:-FAILED}) -- see above."
          exit 1
      fi
      echo "fs01 provisioning complete."

runcmd:
  - /root/provision.sh > /var/log/provision.log 2>&1
