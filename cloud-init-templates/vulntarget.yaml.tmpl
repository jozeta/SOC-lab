#cloud-config
hostname: vulntarget
manage_etc_hosts: false
package_update: true
package_upgrade: true     # start patched; deploy-soc-lab.sh reboots if an update needs it

ssh_authorized_keys:
  - __ANSIBLE_PUBKEY__

write_files:
  - path: /root/provision.sh
    permissions: '0o755'   # explicit octal: Multipass turns '0755' into the integer 493, which fails cloud-init's schema
    content: |
      #!/bin/bash
      set -euo pipefail
      lab_step() {   # progress for deploy-soc-lab.sh's panel: "<n> <what>" in /run/lab-progress
          LAB_STEP=$((${LAB_STEP:-0} + 1))
          printf '%s %s\n' "${LAB_STEP}" "$*" > /run/lab-progress
          echo "== step ${LAB_STEP}: $*"
      }
      export DEBIAN_FRONTEND=noninteractive

      WAZUH_MANAGER="__WAZUH_MANAGER_IP__"

      hostnamectl set-hostname vulntarget

      apt-get update -y
      lab_step "Installing Docker"
      apt-get install -y docker.io
      systemctl enable --now docker

      # DVWA from the project's own image (multi-arch; the old
      # vulnerables/web-dvwa image is amd64-only and can't run on Apple
      # silicon). It needs a separate MariaDB, on a private Docker network.
      # Both credentials are the well-known DVWA lab defaults, on purpose.
      lab_step "Starting DVWA and MariaDB"
      docker network create dvwa-net
      docker run -d --name dvwa-db --restart unless-stopped --network dvwa-net \
          -e MARIADB_ROOT_PASSWORD=dvwa-root -e MARIADB_DATABASE=dvwa \
          -e MARIADB_USER=dvwa -e MARIADB_PASSWORD='p@ssw0rd' \
          mariadb:11
      docker run -d --name dvwa --restart unless-stopped --network dvwa-net \
          -p 80:80 -e DB_SERVER=dvwa-db \
          ghcr.io/digininja/dvwa:latest
      lab_step "Starting Juice Shop"
      docker run -d --name juice-shop --restart unless-stopped -p 3000:3000 bkimminich/juice-shop

      # --- Wazuh agent: reports host-level telemetry. Forwarding the DVWA
      #     container's own access/error logs would need an extra bind
      #     mount + localfile stanza -- left as a next step, see README. ---
      lab_step "Installing the Wazuh agent"
      curl -s https://packages.wazuh.com/key/GPG-KEY-WAZUH | gpg --no-default-keyring --keyring gnupg-ring:/usr/share/keyrings/wazuh.gpg --import
      chmod 644 /usr/share/keyrings/wazuh.gpg
      echo "deb [signed-by=/usr/share/keyrings/wazuh.gpg] https://packages.wazuh.com/4.x/apt/ stable main" > /etc/apt/sources.list.d/wazuh.list
      apt-get update -y
      WAZUH_MANAGER="${WAZUH_MANAGER}" apt-get install -y wazuh-agent
      systemctl daemon-reload
      systemctl enable --now wazuh-agent

      echo "vulntarget ready: DVWA on port 80 (first open /setup.php and click"
      echo "'Create / Reset Database', then log in as admin/password),"
      echo "Juice Shop on port 3000 (no login needed -- start hacking)."

runcmd:
  - /root/provision.sh > /var/log/provision.log 2>&1
