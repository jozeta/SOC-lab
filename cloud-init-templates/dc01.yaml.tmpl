#cloud-config
hostname: dc01
manage_etc_hosts: false
package_update: true
package_upgrade: true     # start patched; deploy-soc-lab.sh reboots if an update needs it
packages:
  - chrony
  - samba
  - krb5-user
  - winbind
  - smbclient
  - ldb-tools

ssh_authorized_keys: __ANSIBLE_KEYS__   # [] without ansible-ctrl

write_files:
  - path: /root/provision.sh
    permissions: '0o755'   # explicit octal: Multipass turns '0755' into the integer 493, which fails cloud-init's schema
    content: |
      #!/bin/bash
      set -euo pipefail
      lab_step() {   # progress for deploy-soc-lab.sh's panel: "<n> <what>" in /run/lab-progress
          LAB_STEP=$((${LAB_STEP:-0} + 1))
          printf '%s %s\n' "${LAB_STEP}" "$*" > /run/lab-progress
          echo "== step ${LAB_STEP}: $*"
      }
      export DEBIAN_FRONTEND=noninteractive

      DOMAIN_REALM="__DOMAIN_REALM__"       # e.g. LAB.LOCAL
      DOMAIN_NETBIOS="__DOMAIN_NETBIOS__"   # e.g. LAB
      ADMIN_PASS="__ADMIN_PASS__"
      WAZUH_MANAGER="__WAZUH_MANAGER_IP__"
      SEED_PASS="__SEED_PASS__"             # alice.user, bob.user, jane.finance, mike.helpdesk
      SVC_SQL_PASS="__SVC_SQL_PASS__"       # kerberoastable service account
      SVC_LEGACY_PASS="__SVC_LEGACY_PASS__" # AS-REP roastable service account

      hostnamectl set-hostname dc01
      MY_IP=$(hostname -I | awk '{print $1}')
      echo "${MY_IP} dc01.${DOMAIN_REALM,,} dc01" >> /etc/hosts

      # Kerberos is sensitive to clock skew -- keep time in sync
      lab_step "Configuring time sync and DNS"
      systemctl enable --now chrony

      # Samba's internal DNS needs port 53; systemd-resolved is in the way
      systemctl disable --now systemd-resolved
      rm -f /etc/resolv.conf
      cat > /etc/resolv.conf <<EOF
      nameserver 127.0.0.1
      search ${DOMAIN_REALM,,}
      EOF

      # --- Provision the AD domain ---
      # dns-forwarder is essential, not optional: every domain member below
      # points ONLY at dc01 for DNS once joined (needed for reliable SRV
      # lookups), so without a forwarder they'd lose all external resolution
      # (apt, curl, the Wazuh agent install, etc.) the moment they join.
      rm -f /etc/samba/smb.conf
      lab_step "Provisioning the AD domain"
      samba-tool domain provision \
          --realm="${DOMAIN_REALM}" \
          --domain="${DOMAIN_NETBIOS}" \
          --server-role=dc \
          --dns-backend=SAMBA_INTERNAL \
          --option="dns forwarder=1.1.1.1" \
          --option="log level = 1 auth_json_audit:3 dsdb_json_audit:5 dsdb_group_json_audit:5 dsdb_password_json_audit:5 kerberos:3" \
          --option="debug syslog format = always" \
          --use-rfc2307 \
          --adminpass="${ADMIN_PASS}"

      cp /var/lib/samba/private/krb5.conf /etc/krb5.conf

      # The log options above produce the audit trail Wazuh's SOC-lab rules
      # read (wazuh/soc_lab_rules.xml): JSON authentication and directory
      # change events, plus the KDC's Kerberos messages.

      # Heimdal (Samba's KDC) requires pre-authentication globally by default,
      # which would make the per-account "do not require pre-auth" flag set
      # on svc_legacy below meaningless. Samba's KDC reads this file first.
      cat > /etc/samba/krb5.conf <<'EOF'
      [kdc]
          require-preauth = false
      EOF

      # The unified samba-ad-dc service replaces standalone smbd/nmbd/winbind
      systemctl disable --now smbd nmbd winbind 2>/dev/null || true
      systemctl unmask samba-ad-dc

      # The packaged unit has Restart=no, so one failed restart takes the
      # whole domain down until someone notices. Seen in practice: after a
      # long suspend, unattended-upgrades restarted samba while the network
      # was being reconfigured, samba failed to bind its IPv6 address
      # (NT_STATUS_ADDRESS_NOT_ASSOCIATED) and stayed dead. Retry instead.
      mkdir -p /etc/systemd/system/samba-ad-dc.service.d
      cat > /etc/systemd/system/samba-ad-dc.service.d/restart.conf <<'EOC'
      [Unit]
      StartLimitIntervalSec=300
      StartLimitBurst=10

      [Service]
      Restart=on-failure
      RestartSec=10
      EOC
      systemctl daemon-reload
      lab_step "Starting the domain controller"
      systemctl enable --now samba-ad-dc

      # Lab domain: passwords never expire. Samba's default maximum password
      # age is 42 days, after which Administrator and the seeded accounts
      # expire and domain joins (net ads join / realm join) fail with
      # "The user account password has expired". Complexity stays on.
      samba-tool domain passwordsettings set --max-pwd-age=0

      # --- Seed a realistic OU / user / group structure so there is
      #     something to hunt and detect against, not just an empty domain ---
      IFS='.' read -ra DC_PARTS <<< "${DOMAIN_REALM,,}"
      BASE_DN=$(printf ",DC=%s" "${DC_PARTS[@]}")
      BASE_DN=${BASE_DN#,}

      lab_step "Creating OUs, groups and users"
      samba-tool ou create "OU=LabUsers,${BASE_DN}"
      samba-tool ou create "OU=LabComputers,${BASE_DN}"
      samba-tool ou create "OU=ServiceAccounts,${BASE_DN}"

      samba-tool group add "IT-Admins"
      samba-tool group add "Finance"
      samba-tool group add "HelpDesk"

      samba-tool user create alice.user    "${SEED_PASS}" --given-name=Alice --surname=User     --userou="OU=LabUsers"
      samba-tool user create bob.user      "${SEED_PASS}" --given-name=Bob   --surname=User     --userou="OU=LabUsers"
      samba-tool user create jane.finance  "${SEED_PASS}" --given-name=Jane  --surname=Finance  --userou="OU=LabUsers"
      samba-tool user create mike.helpdesk "${SEED_PASS}" --given-name=Mike  --surname=Helpdesk --userou="OU=LabUsers"

      samba-tool group addmembers Finance jane.finance
      samba-tool group addmembers HelpDesk mike.helpdesk
      samba-tool group addmembers IT-Admins mike.helpdesk

      # Service account with an SPN -- intentionally left kerberoastable
      # for detection-engineering practice (MITRE ATT&CK T1558.003).
      lab_step "Creating service accounts"
      samba-tool user create svc_sql "${SVC_SQL_PASS}" --given-name=svc_sql --userou="OU=ServiceAccounts"
      samba-tool spn add "MSSQLSvc/fs01.${DOMAIN_REALM,,}:1433" svc_sql

      # Intentionally weak AD settings for the roasting scenarios:
      #  - svc_sql only supports RC4 (a typical legacy service account), so
      #    its kerberoasted ticket is RC4 -- fast to crack, and the signal
      #    the kerberoasting rule looks for.
      #  - svc_legacy has "Do not require Kerberos pre-authentication"
      #    (AS-REP roastable). For that to take effect on Samba, krbtgt needs
      #    the same flag too: Heimdal also checks the server (krbtgt) entry.
      #    Every other account still requires pre-authentication.
      samba-tool user create svc_legacy "${SVC_LEGACY_PASS}" --given-name=svc_legacy --userou="OU=ServiceAccounts"
      SAM=/var/lib/samba/private/sam.ldb
      ldb_set() {   # ldb_set <sAMAccountName> <attribute> <value>
          local dn
          dn=$(ldbsearch -H "${SAM}" "(sAMAccountName=$1)" dn | sed -n 's/^dn: //p')
          printf 'dn: %s\nchangetype: modify\nreplace: %s\n%s: %s\n' "${dn}" "$2" "$2" "$3" \
              | ldbmodify -H "${SAM}"
      }
      uac() { ldbsearch -H "${SAM}" "(sAMAccountName=$1)" userAccountControl | awk '/^userAccountControl:/{print $2}'; }
      DONT_REQ_PREAUTH=4194304
      ldb_set svc_sql msDS-SupportedEncryptionTypes 4
      ldb_set svc_legacy userAccountControl $(( $(uac svc_legacy) | DONT_REQ_PREAUTH ))
      ldb_set krbtgt userAccountControl $(( $(uac krbtgt) | DONT_REQ_PREAUTH ))
      systemctl restart samba-ad-dc

      # --- Wazuh agent: ships the Samba audit trail to the SIEM ---
      if [ -n "${WAZUH_MANAGER}" ]; then
          lab_step "Installing the Wazuh agent"
          curl -s https://packages.wazuh.com/key/GPG-KEY-WAZUH | gpg --no-default-keyring --keyring gnupg-ring:/usr/share/keyrings/wazuh.gpg --import
          chmod 644 /usr/share/keyrings/wazuh.gpg
          echo "deb [signed-by=/usr/share/keyrings/wazuh.gpg] https://packages.wazuh.com/4.x/apt/ stable main" > /etc/apt/sources.list.d/wazuh.list
          apt-get update -y
          WAZUH_MANAGER="${WAZUH_MANAGER}" apt-get install -y wazuh-agent
          cat >> /var/ossec/etc/ossec.conf <<'EOF'

      <!-- SOC-lab: Samba AD DC logs (Kerberos KDC + JSON audit events) -->
      <ossec_config>
        <localfile>
          <log_format>syslog</log_format>
          <location>/var/log/samba/log.samba</location>
        </localfile>
        <localfile>
          <log_format>syslog</log_format>
          <location>/var/log/samba/log.smbd</location>
        </localfile>
      </ossec_config>
      EOF
          systemctl daemon-reload
          systemctl enable --now wazuh-agent
      else
          echo "No siem in this lab: Wazuh agent not installed."
      fi

      echo "dc01 (AD DC) provisioning complete."

runcmd:
  - /root/provision.sh > /var/log/provision.log 2>&1
