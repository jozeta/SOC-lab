#cloud-config
hostname: __HOSTNAME__
manage_etc_hosts: false
package_update: true
package_upgrade: true     # start patched; deploy-soc-lab.sh reboots if an update needs it

ssh_authorized_keys: __ANSIBLE_KEYS__   # [] without ansible-ctrl

write_files:
  - path: /root/provision.sh
    permissions: '0o755'   # explicit octal: Multipass turns '0755' into the integer 493, which fails cloud-init's schema
    content: |
      #!/bin/bash
      set -euo pipefail
      lab_step() {   # progress for deploy-soc-lab.sh's panel: "<n> <what>" in /run/lab-progress
          LAB_STEP=$((${LAB_STEP:-0} + 1))
          printf '%s %s\n' "${LAB_STEP}" "$*" > /run/lab-progress
          echo "== step ${LAB_STEP}: $*"
      }
      export DEBIAN_FRONTEND=noninteractive

      DOMAIN_REALM="__DOMAIN_REALM__"
      DC_IP="__DC_IP__"
      ADMIN_PASS="__ADMIN_PASS__"
      WAZUH_MANAGER="__WAZUH_MANAGER_IP__"
      MY_HOSTNAME="__HOSTNAME__"

      hostnamectl set-hostname "${MY_HOSTNAME}"

      IFACE=$(ip -o -4 route show default | awk '{print $5; exit}')
      # Give this box a resolvable FQDN (as dc01 does). Without it the join
      # can't work out its DNS name and skips registering itself in AD DNS
      # ("No DNS domain configured ... Unable to perform DNS Update").
      MY_IP=$(ip -o -4 addr show dev "${IFACE}" | awk '{split($4,a,"/"); print a[1]; exit}')
      echo "${MY_IP} ${MY_HOSTNAME}.${DOMAIN_REALM,,} ${MY_HOSTNAME}" >> /etc/hosts
      # Point this box's DNS at the DC for the AD domain, persistently: a
      # systemd-resolved drop-in survives reboots and DHCP renewals. (The old
      # netplan drop-in + per-link `resolvectl` override was lost on reboot.)
      mkdir -p /etc/systemd/resolved.conf.d
      cat > /etc/systemd/resolved.conf.d/lab-dns.conf <<EOF
      [Resolve]
      DNS=${DC_IP}
      Domains=${DOMAIN_REALM,,}
      EOF
      systemctl restart systemd-resolved
      resolvectl flush-caches 2>/dev/null || true

      apt-get update -y
      lab_step "Installing sssd and realmd"
      apt-get install -y chrony realmd sssd sssd-tools samba-common-bin adcli \
          oddjob oddjob-mkhomedir packagekit krb5-user dnsutils

      systemctl enable --now chrony

      # `realm join`'s failure on discovery problems is unhelpful too --
      # verify the domain's DNS SRV records resolve before attempting it.
      lab_step "Waiting for AD DNS"
      SRV_OK=""
      for i in $(seq 1 12); do
          resolvectl flush-caches 2>/dev/null || true
          if host -t SRV "_ldap._tcp.${DOMAIN_REALM,,}" >/dev/null 2>&1; then
              SRV_OK="yes"
              break
          fi
          echo "Waiting for DNS (${DC_IP}) to serve ${DOMAIN_REALM,,} SRV records... (${i}/12)"
          sleep 5
      done
      if [ -z "${SRV_OK}" ]; then
          echo "ERROR: cannot resolve _ldap._tcp.${DOMAIN_REALM,,} SRV records."
          echo "--- /etc/resolv.conf ---"; cat /etc/resolv.conf
          echo "--- resolvectl status ---"; resolvectl status || true
          exit 1
      fi

      # realmd/sssd is the modern, cleaner join method for a box that only
      # needs domain login/sudo -- no file-share idmap complexity like fs01.
      lab_step "Joining the domain"
      echo "${ADMIN_PASS}" | realm join --user=administrator "${DOMAIN_REALM}" -v
      realm permit --all   # lab convenience: any domain account may log in here
      pam-auth-update --enable mkhomedir

      # Register this client in AD DNS: realm join itself doesn't, sssd's
      # dynamic DNS update does -- given an explicit FQDN, since the system
      # hostname is the short name. By default sssd delays the first update
      # by a random 0-300 s (dyndns_refresh_interval_offset) -- run it right
      # away instead. The lab has no reverse DNS zone, so skip PTR updates
      # (with them on, sssd reports every update as failed).
      sed -i "/^\[domain\/${DOMAIN_REALM,,}\]/a ad_hostname = ${MY_HOSTNAME}.${DOMAIN_REALM,,}\ndyndns_update = true\ndyndns_iface = ${IFACE}\ndyndns_refresh_interval_offset = 0\ndyndns_update_ptr = false" /etc/sssd/sssd.conf
      lab_step "Registering in AD DNS"
      systemctl restart sssd
      DNS_OK=""
      for i in $(seq 1 12); do
          if host "${MY_HOSTNAME}.${DOMAIN_REALM,,}" "${DC_IP}" 2>/dev/null | grep -q "has address ${MY_IP}"; then
              DNS_OK="yes"; break
          fi
          echo "Waiting for sssd to register ${MY_HOSTNAME}.${DOMAIN_REALM,,} in AD DNS... (${i}/12)"
          sleep 5
      done
      if [ -z "${DNS_OK}" ]; then
          echo "ERROR: ${MY_HOSTNAME}.${DOMAIN_REALM,,} -> ${MY_IP} not registered in AD DNS."
          grep -A8 "^\[domain/" /etc/sssd/sssd.conf || true
      fi

      # --- Wazuh agent: this is the "endpoint" telemetry source ---
      if [ -n "${WAZUH_MANAGER}" ]; then
          lab_step "Installing the Wazuh agent"
          # Wazuh's package signing key, imported only if it is that key (fingerprint as pinned in
          # Wazuh's own installer, wazuh-installation-assistant).
          curl -fsSL --retry 5 --retry-delay 10 -o /tmp/wazuh.key https://packages.wazuh.com/key/GPG-KEY-WAZUH
          [ "$(gpg --show-keys --with-colons /tmp/wazuh.key | awk -F: '$1 == "fpr" { print $10; exit }')" = 0DCFCA5547B19D2A6099506096B3EE5F29111145 ]
          gpg --no-default-keyring --keyring gnupg-ring:/usr/share/keyrings/wazuh.gpg --import /tmp/wazuh.key
          rm -f /tmp/wazuh.key
          chmod 644 /usr/share/keyrings/wazuh.gpg
          echo "deb [signed-by=/usr/share/keyrings/wazuh.gpg] https://packages.wazuh.com/4.x/apt/ stable main" > /etc/apt/sources.list.d/wazuh.list
          apt-get update -y
          WAZUH_MANAGER="${WAZUH_MANAGER}" apt-get install -y wazuh-agent
          systemctl daemon-reload
          systemctl enable --now wazuh-agent
      else
          echo "No siem in this lab: Wazuh agent not installed."
      fi

      if [ -z "${DNS_OK}" ]; then
          echo "${MY_HOSTNAME} provisioning finished WITH ERRORS: DNS record missing (see above)."
          exit 1
      fi
      echo "${MY_HOSTNAME} provisioning complete."

runcmd:
  - /root/provision.sh > /var/log/provision.log 2>&1
