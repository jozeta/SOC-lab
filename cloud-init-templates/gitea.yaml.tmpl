#cloud-config
hostname: gitea
manage_etc_hosts: false
package_update: true
package_upgrade: true     # start patched; deploy-soc-lab.sh reboots if an update needs it

ssh_authorized_keys: __ANSIBLE_KEYS__   # [] without ansible-ctrl

write_files:
  # --- Helpers the pipeline's jobs call on this runner host -----------------
  - path: /usr/local/bin/lab-checkout
    permissions: '0o755'   # explicit octal: Multipass turns '0755' into the integer 493, which fails cloud-init's schema
    content: |
      #!/bin/bash
      # Clone the repository the workflow runs for into ./src (full history,
      # so the secret scan sees every commit). Uses the job's GITEA_TOKEN.
      # lab-checkout [ref]: check out that ref (e.g. refs/pull/3/head) instead
      # of the commit the run is for.
      set -euo pipefail
      : "${TOKEN:?set TOKEN to the job token}"
      rm -rf src
      git clone --quiet "http://ci:${TOKEN}@${GITHUB_SERVER_URL#*://}/${GITHUB_REPOSITORY}.git" src < /dev/null
      if [ -n "${1:-}" ]; then
          git -C src fetch --quiet origin "$1" < /dev/null
          git -C src checkout --quiet FETCH_HEAD
          echo "checked out ${GITHUB_REPOSITORY} $1 ($(git -C src rev-parse --short=12 HEAD))"
          exit 0
      fi
      git -C src checkout --quiet "${GITHUB_SHA}"
      echo "checked out ${GITHUB_REPOSITORY}@${GITHUB_SHA:0:12}"
  - path: /usr/local/bin/lab-event
    permissions: '0o755'   # explicit octal: Multipass turns '0755' into the integer 493, which fails cloud-init's schema
    content: |
      #!/bin/bash
      # lab-event <event> <detail>: append a pipeline event (JSON) to
      # /var/log/cicd/events.log, which Wazuh reads.
      set -euo pipefail
      jq -cn --arg event "$1" --arg detail "${2:-}" --arg repo "${GITHUB_REPOSITORY:-}" \
          --arg sha "${GITHUB_SHA:-}" --arg actor "${GITHUB_ACTOR:-}" --arg run "${GITHUB_RUN_NUMBER:-}" \
          '{lab_source: "cicd-pipeline", event: $event, detail: $detail, repo: $repo,
            sha: $sha, actor: $actor, run: $run, time: (now | todate)}' >> /var/log/cicd/events.log
  # --- DevSecOps only (installed when DEVSECOPS=1) -------------------------
  - path: /opt/cicd/devsecops/lab-policy
    permissions: '0o755'   # explicit octal: Multipass turns '0755' into the integer 493, which fails cloud-init's schema
    content: |
      #!/bin/bash
      # lab-policy <image:tag>: the policy gate before anything reaches prod. Passes only an image
      #   - pushed to this lab's registry (it has a digest there),
      #   - signed with the lab's cosign key (checked against the registry, by digest),
      #   - built to run as a non-root user.
      # Prints the digest reference to deploy on success; exits 1 with the reason otherwise.
      set -euo pipefail
      tag="${1:?usage: lab-policy <image:tag>}"
      deny() {
          echo "POLICY DENIED: $*" >&2
          lab-event policy_denied "${tag}: $*" || true
          exit 1
      }
      repo="${tag%:*}"
      ref=$(docker image inspect --format '{{range .RepoDigests}}{{println .}}{{end}}' "${tag}" \
          | grep -m 1 "^${repo}@sha256:" || true)
      [ -n "${ref}" ] || deny "image was never pushed to ${repo%%/*}"
      if ! timeout 120 cosign verify --key /etc/cosign/cosign.pub --insecure-ignore-tlog \
          --allow-http-registry --allow-insecure-registry "${ref}" > /dev/null 2> cosign-verify.log < /dev/null; then
          cat cosign-verify.log >&2
          deny "no valid signature from the lab's cosign key"
      fi
      user=$(docker image inspect --format '{{.Config.User}}' "${tag}")
      case "${user%%:*}" in
          ""|root|0) deny "image runs as root (USER '${user}')" ;;
      esac
      echo "policy passed: signed by the lab key, runs as '${user}'" >&2
      echo "${ref}"
  - path: /root/cicd-release.sh
    permissions: '0o755'   # explicit octal: Multipass turns '0755' into the integer 493, which fails cloud-init's schema
    content: |
      #!/bin/bash
      # cicd-release.sh <prod-ip>: DevSecOps only. Ship "release 1.0" (demo-app's main as seeded, from
      # before the security gates existed) the way the pipeline's last jobs do: build, push, sign with
      # the lab's cosign key, deploy to prod by digest (prod checks the signature). Skipped while prod
      # already answers, so re-running the deploy is safe.
      set -euo pipefail
      ADMIN_PASS="__ADMIN_PASS__"
      prod="${1:?usage: cicd-release.sh <prod-ip>}"
      if curl -fs -m 5 -o /dev/null "http://${prod}:8080/health"; then
          echo "prod already runs a release -- not re-releasing"
          exit 0
      fi
      MY_IP=$(ip -o -4 route get 1.1.1.1 | awk '{for (i = 1; i < NF; i++) if ($i == "src") print $(i + 1)}')
      registry="${MY_IP}:3000"
      work=$(mktemp -d)
      trap 'rm -rf "${work}"' EXIT
      auth=$(printf 'labadmin:%s' "${ADMIN_PASS}" | base64 -w0)
      timeout 120 git -c http.extraHeader="Authorization: Basic ${auth}" \
          clone -q http://127.0.0.1:3000/labadmin/demo-app.git "${work}/src" < /dev/null
      short=$(git -C "${work}/src" rev-parse --short=12 HEAD)
      image="${registry}/labadmin/demo-app:${short}"
      timeout 900 docker build -q --pull --build-arg BUILD_SHA="${short}" -t "${image}" "${work}/src" < /dev/null
      timeout 60 docker login "${registry}" -u labadmin --password-stdin < /root/cicd/registry-token > /dev/null
      timeout 300 docker push -q "${image}" < /dev/null
      ref=$(docker image inspect --format '{{index .RepoDigests 0}}' "${image}")
      # shellcheck source=/dev/null
      source /root/cicd/cosign.env   # COSIGN_PASSWORD
      export COSIGN_PASSWORD
      timeout 300 cosign sign --yes --key /root/cicd/cosign.key \
          --signing-config /etc/cosign/offline-signing-config.json \
          --allow-http-registry --allow-insecure-registry "${ref}" < /dev/null
      timeout 600 ssh -i /root/cicd/deploy_key -o BatchMode=yes -o StrictHostKeyChecking=accept-new \
          -o UserKnownHostsFile=/root/cicd/known_hosts "deploy@${prod}" "${ref}" < /dev/null
      GITHUB_REPOSITORY=labadmin/demo-app GITHUB_SHA="${short}" lab-event release_deployed "${ref}"
      echo "release ${short} signed and deployed to prod: ${ref}"
  # --- Git hook: audit every push (runs inside the Gitea container) --------
  - path: /opt/cicd/lab-audit-hook
    permissions: '0o755'   # explicit octal: Multipass turns '0755' into the integer 493, which fails cloud-init's schema
    content: |
      #!/bin/sh
      # post-receive hook: log each pushed ref as JSON for Wazuh, flagging
      # force pushes and changes to the CI pipeline definition.
      log=/data/gitea/log/lab-audit.log
      zero=0000000000000000000000000000000000000000
      while read -r old new ref; do
          event=push
          files=""
          if [ "$new" = "$zero" ]; then
              event=ref_deleted
          elif [ "$old" = "$zero" ]; then
              files=$(git ls-tree -r --name-only "$new" | grep '^\.gitea/workflows/' | tr '\n' ' ')
          else
              if ! git merge-base --is-ancestor "$old" "$new" 2>/dev/null; then
                  event=force_push
              fi
              files=$(git diff --name-only "$old" "$new" | grep '^\.gitea/workflows/' | tr '\n' ' ')
          fi
          workflow_changed=false
          [ -n "$files" ] && [ "$old" != "$zero" ] && workflow_changed=true
          printf '{"lab_source":"gitea-hook","event":"%s","repo":"%s/%s","ref":"%s","old":"%s","new":"%s","pusher":"%s","workflow_changed":%s,"workflow_files":"%s"}\n' \
              "$event" "$GITEA_REPO_USER_NAME" "$GITEA_REPO_NAME" "$ref" "$old" "$new" \
              "$GITEA_PUSHER_NAME" "$workflow_changed" "${files% }" >> "$log"
      done
  # --- The demo application and its pipeline (seeded into Gitea) ----------
  - path: /opt/cicd/seed/app.py
    content: |
      """SOC-lab demo app, built and deployed by the Gitea pipeline."""
      import os

      from flask import Flask, jsonify

      app = Flask(__name__)


      @app.get("/")
      def index():
          return (
              "<h1>SOC-lab demo app</h1>"
              f"<p>Build: {os.environ.get('BUILD_SHA', 'unknown')}</p>"
              "<p>Shipped by the Gitea pipeline: secret scan, SAST, dependency scan,"
              " Dockerfile lint, image scan, deploy.</p>"
          )


      @app.get("/health")
      def health():
          return jsonify(status="ok", build=os.environ.get("BUILD_SHA", "unknown"))
  - path: /opt/cicd/seed/requirements.txt
    content: |
      flask==3.1.3
      gunicorn==26.2.0
  - path: /opt/cicd/seed/Dockerfile
    content: |
      FROM python:3.12-slim
      WORKDIR /app
      COPY requirements.txt .
      RUN pip install --no-cache-dir -r requirements.txt
      COPY app.py .
      ARG BUILD_SHA=unknown
      ENV BUILD_SHA=${BUILD_SHA}
      RUN useradd --create-home appuser
      USER appuser
      EXPOSE 8080
      CMD ["gunicorn", "--bind", "0.0.0.0:8080", "--workers", "2", "app:app"]
  - path: /opt/cicd/seed/README.md
    content: |
      # demo-app

      A tiny Flask app that the SOC-lab CI/CD pipeline builds, checks and
      deploys to the `prod` VM. Push to `main` and watch the run under
      **Actions**. Exercises are in the SOC-lab README.
  - path: /opt/cicd/seed/.gitea/workflows/pipeline.yml
    content: |
      # Commit -> security/quality gates -> image build + scan -> deploy to prod.
      # Every gate must pass before anything is built or deployed.
      name: pipeline
      on:
        push:
          branches: [main]

      env:
        TOKEN: ${{ secrets.GITEA_TOKEN }}

      jobs:
        secret-scan:
          runs-on: lab-host
          steps:
            - name: Check out
              run: lab-checkout
            - name: gitleaks - hardcoded secrets in the whole history
              run: docker run --rm -v "$PWD/src:/repo" zricethezav/gitleaks:v8.30.1 git /repo --no-banner --redact
            - name: Record failed gate
              if: failure()
              run: lab-event gate_failed secret-scan

        sast:
          runs-on: lab-host
          steps:
            - name: Check out
              run: lab-checkout
            - name: Semgrep - code scan
              run: >-
                docker run --rm -v "$PWD/src:/src" -w /src semgrep/semgrep:1.181.0
                semgrep scan --config p/python --config p/dockerfile --error --metrics=off --disable-version-check --quiet
            - name: Record failed gate
              if: failure()
              run: lab-event gate_failed sast

        dependency-scan:
          runs-on: lab-host
          steps:
            - name: Check out
              run: lab-checkout
            - name: Trivy - vulnerable dependencies
              run: >-
                docker run --rm -v trivy-cache:/root/.cache -v "$PWD/src:/src" aquasec/trivy:0.76.0
                fs --scanners vuln --severity HIGH,CRITICAL --ignore-unfixed --exit-code 1 --quiet /src
            - name: Record failed gate
              if: failure()
              run: lab-event gate_failed dependency-scan

        dockerfile-lint:
          runs-on: lab-host
          steps:
            - name: Check out
              run: lab-checkout
            - name: hadolint - Dockerfile best practices
              run: docker run --rm -i hadolint/hadolint:v2.15.1 hadolint --failure-threshold error - < src/Dockerfile
            - name: Record failed gate
              if: failure()
              run: lab-event gate_failed dockerfile-lint

        build:
          needs: [secret-scan, sast, dependency-scan, dockerfile-lint]
          runs-on: lab-host
          steps:
            - name: Check out
              run: lab-checkout
            - name: Build image
              run: |
                IMAGE="${{ vars.REGISTRY }}/${GITHUB_REPOSITORY}:${GITHUB_SHA:0:12}"
                docker build --pull --build-arg BUILD_SHA="${GITHUB_SHA:0:12}" -t "$IMAGE" src
                echo "IMAGE=$IMAGE" >> "$GITHUB_ENV"
            - name: Trivy - scan the image
              run: >-
                docker run --rm -v trivy-cache:/root/.cache -v /var/run/docker.sock:/var/run/docker.sock
                aquasec/trivy:0.76.0 image --severity CRITICAL --ignore-unfixed --exit-code 1 --quiet "$IMAGE"
            - name: Push to the Gitea registry
              run: |
                echo "${{ secrets.REGISTRY_TOKEN }}" | docker login "${{ vars.REGISTRY }}" -u labadmin --password-stdin
                docker push "$IMAGE"
                lab-event image_pushed "$IMAGE"
            - name: Record failed gate
              if: failure()
              run: lab-event gate_failed build

        deploy:
          needs: build
          runs-on: lab-host
          steps:
            - name: Deploy to prod
              run: |
                IMAGE="${{ vars.REGISTRY }}/${GITHUB_REPOSITORY}:${GITHUB_SHA:0:12}"
                umask 077
                printf '%s\n' "${{ secrets.DEPLOY_KEY }}" > deploy_key
                ssh -i deploy_key -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=known_hosts \
                    "deploy@${{ vars.PROD_HOST }}" "$IMAGE"
                rm -f deploy_key
                lab-event deployed "$IMAGE"
            - name: Record failed deploy
              if: failure()
              run: lab-event deploy_failed prod

  # --- Wiring, run by deploy-soc-lab.sh once both gitea and prod are up -----
  - path: /root/cicd-wire.sh
    permissions: '0o755'   # explicit octal: Multipass turns '0755' into the integer 493, which fails cloud-init's schema
    content: |
      #!/bin/bash
      # cicd-wire.sh <prod-ip>: point the pipeline at prod, then print what
      # prod needs (deploy public key, registry read token) as KEY=value.
      set -euo pipefail
      ADMIN_PASS="__ADMIN_PASS__"
      url=http://127.0.0.1:3000/api/v1/repos/labadmin/demo-app/actions/variables/PROD_HOST
      body="{\"value\":\"$1\"}"
      curl -fsS -u "labadmin:${ADMIN_PASS}" -X POST -H 'Content-Type: application/json' "${url}" -d "${body}" > /dev/null 2>&1 \
          || curl -fsS -u "labadmin:${ADMIN_PASS}" -X PUT -H 'Content-Type: application/json' "${url}" -d "${body}" > /dev/null
      echo "DEPLOY_PUBKEY=$(cat /root/cicd/deploy_key.pub)"
      echo "REGISTRY_TOKEN=$(cat /root/cicd/registry-token)"
      if [ -f /etc/cosign/cosign.pub ]; then   # DevSecOps: prod only runs images signed with this key
          echo "COSIGN_PUBKEY_B64=$(base64 -w0 /etc/cosign/cosign.pub)"
      fi
  - path: /root/cicd-seed.sh
    permissions: '0o755'   # explicit octal: Multipass turns '0755' into the integer 493, which fails cloud-init's schema
    content: |
      #!/bin/bash
      # Push the demo app as the "dev" user (first pipeline run). Skipped if
      # the repository already has commits, so re-running the deploy is safe.
      set -euo pipefail
      DEV_PASS="__SEED_PASS__"
      if [ "$(curl -fsS http://127.0.0.1:3000/api/v1/repos/labadmin/demo-app | jq -r .empty)" != "true" ]; then
          echo "demo-app already has commits -- not re-seeding"
          exit 0
      fi
      work=$(mktemp -d)
      cp -a /opt/cicd/seed/. "${work}"
      cd "${work}"
      git init -q -b main
      git -c user.name=dev -c user.email=dev@lab.local add -A
      git -c user.name=dev -c user.email=dev@lab.local commit -q -m "Initial demo app with CI/CD pipeline"
      auth=$(printf 'dev:%s' "${DEV_PASS}" | base64 -w0)
      git -c http.extraHeader="Authorization: Basic ${auth}" \
          push -q http://127.0.0.1:3000/labadmin/demo-app.git main
      rm -rf "${work}"
      echo "demo-app pushed as dev -- pipeline started"

  - path: /root/provision.sh
    permissions: '0o755'   # explicit octal: Multipass turns '0755' into the integer 493, which fails cloud-init's schema
    content: |
      #!/bin/bash
      set -euo pipefail
      lab_step() {   # progress for deploy-soc-lab.sh's panel: "<n> <what>" in /run/lab-progress
          LAB_STEP=$((${LAB_STEP:-0} + 1))
          printf '%s %s\n' "${LAB_STEP}" "$*" > /run/lab-progress
          echo "== step ${LAB_STEP}: $*"
      }
      export DEBIAN_FRONTEND=noninteractive

      ADMIN_PASS="__ADMIN_PASS__"     # Gitea admin "labadmin"
      DEV_PASS="__SEED_PASS__"        # Gitea developer "dev"
      WAZUH_MANAGER="__WAZUH_MANAGER_IP__"
      DEVSECOPS="__DEVSECOPS__"       # 1: DevSecOps lab (scanners, signing, policy gate)

      # Pinned: newest releases at least two weeks old when this was written.
      GITEA_VERSION="28.2.0"
      RUNNER_VERSION="0.6.1"
      RUNNER_SHA256="98d143b5a3b50a2f8e5b8e5ee31e10dad35099a9a0e394c43ac2998df396766f"

      hostnamectl set-hostname gitea
      MY_IP=$(ip -o -4 route get 1.1.1.1 | awk '{for (i = 1; i < NF; i++) if ($i == "src") print $(i + 1)}')

      apt-get update -y
      lab_step "Installing Docker"
      apt-get install -y docker.io git jq curl

      # The registry is plain HTTP inside the lab network.
      mkdir -p /etc/docker
      printf '{"insecure-registries": ["%s:3000"]}\n' "${MY_IP}" > /etc/docker/daemon.json
      systemctl enable docker
      systemctl restart docker

      # --- Gitea (SQLite, Actions + container registry enabled) ---
      mkdir -p /opt/gitea/data
      lab_step "Starting Gitea"
      docker run -d --name gitea --restart unless-stopped \
          -p 3000:3000 -p 2222:22 \
          -e USER_UID=1000 -e USER_GID=1000 \
          -e GITEA__database__DB_TYPE=sqlite3 \
          -e GITEA__security__INSTALL_LOCK=true \
          -e GITEA__server__ROOT_URL="http://${MY_IP}:3000/" \
          -e GITEA__server__DOMAIN="${MY_IP}" \
          -e GITEA__server__SSH_DOMAIN="${MY_IP}" \
          -e GITEA__server__SSH_PORT=2222 \
          -e GITEA__service__DISABLE_REGISTRATION=true \
          -e GITEA__actions__ENABLED=true \
          -e GITEA__packages__ENABLED=true \
          -e GITEA__log__MODE=console,file \
          -e GITEA__log__ROOT_PATH=/data/gitea/log \
          -v /opt/gitea/data:/data \
          "gitea/gitea:${GITEA_VERSION}"
      for _ in $(seq 1 60); do
          curl -fs http://127.0.0.1:3000/api/healthz > /dev/null 2>&1 && break
          sleep 3
      done
      curl -fs http://127.0.0.1:3000/api/healthz > /dev/null

      gitea() { docker exec -u git gitea gitea "$@"; }
      gitea admin user create --admin --username labadmin --password "${ADMIN_PASS}" \
          --email labadmin@lab.local --must-change-password=false
      gitea admin user create --username dev --password "${DEV_PASS}" \
          --email dev@lab.local --must-change-password=false

      API=http://127.0.0.1:3000/api/v1
      api() {   # api <method> <path> [json] -- as labadmin
          curl -fsS -u "labadmin:${ADMIN_PASS}" -X "$1" -H 'Content-Type: application/json' \
              "${API}$2" ${3:+-d "$3"}
      }
      api POST /user/repos '{"name":"demo-app","default_branch":"main","description":"SOC-lab CI/CD demo"}' > /dev/null
      api PUT /repos/labadmin/demo-app/collaborators/dev '{"permission":"write"}' > /dev/null
      api POST /repos/labadmin/demo-app/actions/variables/REGISTRY "{\"value\":\"${MY_IP}:3000\"}" > /dev/null

      # Audit hook on the repo (Gitea runs every executable in post-receive.d).
      HOOKS=/opt/gitea/data/git/repositories/labadmin/demo-app.git/hooks/post-receive.d
      lab_step "Setting up hooks and pipeline keys"
      install -o 1000 -g 1000 -m 755 /opt/cicd/lab-audit-hook "${HOOKS}/lab-audit"

      # Credentials the pipeline uses: a registry token and an SSH deploy key.
      mkdir -p /root/cicd && chmod 700 /root/cicd
      api POST /users/labadmin/tokens '{"name":"ci-registry","scopes":["write:package","read:package"]}' \
          | jq -r .sha1 > /root/cicd/registry-token
      ssh-keygen -q -t ed25519 -N '' -C "gitea-pipeline-deploy" -f /root/cicd/deploy_key
      api PUT /repos/labadmin/demo-app/actions/secrets/REGISTRY_TOKEN \
          "$(jq -cn --arg d "$(cat /root/cicd/registry-token)" '{data: $d}')"
      api PUT /repos/labadmin/demo-app/actions/secrets/DEPLOY_KEY \
          "$(jq -cn --arg d "$(cat /root/cicd/deploy_key)" '{data: $d}')"

      # --- Actions runner on this host ("host" mode: jobs run here, with docker) ---
      useradd --create-home --shell /bin/bash --groups docker runner
      lab_step "Installing the Actions runner"
      curl -fsSL -o /usr/local/bin/act_runner \
          "https://dl.gitea.com/act_runner/${RUNNER_VERSION}/act_runner-${RUNNER_VERSION}-linux-arm64"
      echo "${RUNNER_SHA256}  /usr/local/bin/act_runner" | sha256sum -c -
      chmod 755 /usr/local/bin/act_runner
      RUNNER_TOKEN=$(gitea actions generate-runner-token | tail -n 1)
      sudo -u runner -H bash -c "cd ~ && act_runner register --no-interactive \
          --instance http://${MY_IP}:3000 --token ${RUNNER_TOKEN} --name gitea-runner --labels lab-host:host"
      cat > /etc/systemd/system/act_runner.service <<'EOC'
      [Unit]
      Description=Gitea Actions runner
      After=docker.service network-online.target
      Wants=network-online.target

      [Service]
      User=runner
      WorkingDirectory=/home/runner
      ExecStart=/usr/local/bin/act_runner daemon
      Restart=always
      RestartSec=5

      [Install]
      WantedBy=multi-user.target
      EOC
      mkdir -p /var/log/cicd
      touch /var/log/cicd/events.log
      chown runner:runner /var/log/cicd/events.log
      systemctl daemon-reload
      systemctl enable --now act_runner

      # --- DevSecOps: pinned scanners, the signing key and the policy gate ---
      if [ "${DEVSECOPS}" = "1" ]; then
          lab_step "Installing the security scanners"
          # Pinned to the newest releases at least two weeks old when this was written; arm64 builds.
          # sha256 values are from each release's checksum file; the trivy tarball and the cosign
          # binary were also checked against their Sigstore signatures (cosign verify-blob) then.
          GITLEAKS_VERSION=8.30.1
          GITLEAKS_SHA256=e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080
          OSV_VERSION=2.7.0
          OSV_SHA256=4061ef4c021ed3c47f203b818f337e351336cc5cd67c0274fc36bd1dfc728dd7
          TRIVY_VERSION=0.76.1
          TRIVY_SHA256=e174dff2a6dba5e3ae41f8d0537a6324405bd08132497340304c6b20e0f16a1f
          COSIGN_VERSION=3.1.4
          COSIGN_SHA256=ade83b7aac62e131cacfe96d958948b2150cc9efec46a570a2649b8e27dedad2
          SEMGREP_IMAGE="semgrep/semgrep:1.182.0@sha256:4a34048c04fef049f71665047f074cffb00cc3d89482f965a5cd151d589237af"
          # Semgrep's rules: semgrep/semgrep-rules at this commit (2026-10-21), not the live registry,
          # so every scan uses the same rules and needs no internet. git checks each file against it.
          SEMGREP_RULES_COMMIT=16b9e6d45f10649f6a531ec4838ed9924372c3bc
          fetch() {   # fetch <url> <sha256> <file>: download with retries, refuse a wrong checksum
              curl -fsSL --retry 5 --retry-delay 20 -o "$3" "$1"
              echo "$2  $3" | sha256sum -c -
          }
          gh=https://github.com
          fetch "${gh}/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_arm64.tar.gz" \
              "${GITLEAKS_SHA256}" /tmp/gitleaks.tar.gz
          tar -xzf /tmp/gitleaks.tar.gz -C /usr/local/bin gitleaks
          fetch "${gh}/google/osv-scanner/releases/download/v${OSV_VERSION}/osv-scanner_linux_arm64" \
              "${OSV_SHA256}" /tmp/osv-scanner
          install -m 755 /tmp/osv-scanner /usr/local/bin/osv-scanner
          fetch "${gh}/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_Linux-ARM64.tar.gz" \
              "${TRIVY_SHA256}" /tmp/trivy.tar.gz
          tar -xzf /tmp/trivy.tar.gz -C /usr/local/bin trivy
          fetch "${gh}/sigstore/cosign/releases/download/v${COSIGN_VERSION}/cosign-linux-arm64" \
              "${COSIGN_SHA256}" /tmp/cosign
          install -m 755 /tmp/cosign /usr/local/bin/cosign
          chown root:root /usr/local/bin/gitleaks /usr/local/bin/trivy
          rm -f /tmp/gitleaks.tar.gz /tmp/osv-scanner /tmp/trivy.tar.gz /tmp/cosign
          # Semgrep runs from its image, pinned by digest (Docker checks it on pull).
          ok=0
          for _ in 1 2 3; do
              if docker pull --quiet "${SEMGREP_IMAGE}"; then ok=1; break; fi
              sleep 20
          done
          [ "${ok}" = 1 ]
          rm -rf /opt/semgrep-rules
          git init -q /opt/semgrep-rules
          ok=0
          for _ in 1 2 3; do
              if git -C /opt/semgrep-rules fetch -q --depth 1 https://github.com/semgrep/semgrep-rules.git \
                  "${SEMGREP_RULES_COMMIT}"; then ok=1; break; fi
              sleep 20
          done
          [ "${ok}" = 1 ]
          git -C /opt/semgrep-rules -c advice.detachedHead=false checkout -q FETCH_HEAD
          [ "$(git -C /opt/semgrep-rules rev-parse HEAD)" = "${SEMGREP_RULES_COMMIT}" ]
          cat > /usr/local/bin/semgrep <<EOS
      #!/bin/sh
      # semgrep from its pinned image, on the current directory, with the pinned rules in /rules.
      exec docker run --rm -v "\$PWD:/src" -v /opt/semgrep-rules:/rules:ro -w /src ${SEMGREP_IMAGE} semgrep "\$@"
      EOS
          chmod 755 /usr/local/bin/semgrep
          # node runs the JavaScript actions (actions/checkout ...) that the PR workflows use.
          apt-get install -y nodejs
          install -m 755 /opt/cicd/devsecops/lab-policy /usr/local/bin/lab-policy

          lab_step "Creating the image signing key"
          # The pipeline signs with this key (repo secrets); lab-policy and prod verify with the
          # public half. No transparency log: the lab is offline from Sigstore's point of view.
          install -d -m 755 /etc/cosign
          (umask 077 && printf 'COSIGN_PASSWORD=%s\n' "$(openssl rand -hex 16)" > /root/cicd/cosign.env)
          # shellcheck source=/dev/null
          source /root/cicd/cosign.env
          export COSIGN_PASSWORD
          (cd /root/cicd && cosign generate-key-pair --output-key-prefix cosign < /dev/null)
          install -m 644 /root/cicd/cosign.pub /etc/cosign/cosign.pub
          cosign signing-config create --out /etc/cosign/offline-signing-config.json < /dev/null
          chmod 644 /etc/cosign/offline-signing-config.json
          api PUT /repos/labadmin/demo-app/actions/secrets/COSIGN_KEY \
              "$(jq -cn --arg d "$(cat /root/cicd/cosign.key)" '{data: $d}')"
          api PUT /repos/labadmin/demo-app/actions/secrets/COSIGN_PASSWORD \
              "$(jq -cn --arg d "${COSIGN_PASSWORD}" '{data: $d}')"
          unset COSIGN_PASSWORD

          # The runner's own log, for siem in large.
          mkdir -p /etc/systemd/system/act_runner.service.d
          printf '[Service]\nStandardOutput=append:/var/log/cicd/act_runner.log\nStandardError=inherit\n' \
              > /etc/systemd/system/act_runner.service.d/lab-log.conf
          touch /var/log/cicd/act_runner.log
          systemctl daemon-reload
          systemctl restart act_runner
      fi

      # --- Wazuh agent: pushes, pipeline events and Gitea's own log ---
      if [ -n "${WAZUH_MANAGER}" ]; then
          lab_step "Installing the Wazuh agent"
          curl -s https://packages.wazuh.com/key/GPG-KEY-WAZUH | gpg --no-default-keyring --keyring gnupg-ring:/usr/share/keyrings/wazuh.gpg --import
          chmod 644 /usr/share/keyrings/wazuh.gpg
          echo "deb [signed-by=/usr/share/keyrings/wazuh.gpg] https://packages.wazuh.com/4.x/apt/ stable main" > /etc/apt/sources.list.d/wazuh.list
          apt-get update -y
          WAZUH_MANAGER="${WAZUH_MANAGER}" apt-get install -y wazuh-agent
          cat >> /var/ossec/etc/ossec.conf <<'EOF'

      <!-- SOC-lab: CI/CD audit trail -->
      <ossec_config>
        <localfile>
          <log_format>json</log_format>
          <location>/opt/gitea/data/gitea/log/lab-audit.log</location>
        </localfile>
        <localfile>
          <log_format>json</log_format>
          <location>/var/log/cicd/events.log</location>
        </localfile>
        <localfile>
          <log_format>syslog</log_format>
          <location>/opt/gitea/data/gitea/log/gitea.log</location>
        </localfile>
      </ossec_config>
      EOF
          # Registry pushes and pulls are in gitea.log ("router: completed PUT /v2/...").
          if [ "${DEVSECOPS}" = "1" ]; then   # the Actions runner's own log
              cat >> /var/ossec/etc/ossec.conf <<'EOF'

      <!-- SOC-lab DevSecOps: the Actions runner's log -->
      <ossec_config>
        <localfile>
          <log_format>syslog</log_format>
          <location>/var/log/cicd/act_runner.log</location>
        </localfile>
      </ossec_config>
      EOF
          fi
          systemctl daemon-reload
          systemctl enable --now wazuh-agent
      else
          echo "No siem in this lab: Wazuh agent not installed."
      fi

      echo "gitea provisioning complete: http://${MY_IP}:3000 (labadmin / dev)."
      echo "deploy-soc-lab.sh wires the pipeline to prod and pushes demo-app."

runcmd:
  - /root/provision.sh > /var/log/provision.log 2>&1
