#cloud-config
hostname: webtarget2
manage_etc_hosts: false
package_update: true
package_upgrade: true     # start patched; deploy-soc-lab.sh reboots if an update needs it

ssh_authorized_keys: __ANSIBLE_KEYS__   # [] without ansible-ctrl

write_files:
  - path: /root/provision.sh
    permissions: '0o755'   # explicit octal: Multipass turns '0755' into the integer 493, which fails cloud-init's schema
    content: |
      #!/bin/bash
      set -euo pipefail
      lab_step() {   # progress for deploy-soc-lab.sh's panel: "<n> <what>" in /run/lab-progress
          LAB_STEP=$((${LAB_STEP:-0} + 1))
          printf '%s %s\n' "${LAB_STEP}" "$*" > /run/lab-progress
          echo "== step ${LAB_STEP}: $*"
      }
      export DEBIAN_FRONTEND=noninteractive

      WAZUH_MANAGER="__WAZUH_MANAGER_IP__"

      hostnamectl set-hostname webtarget2

      apt-get update -y
      lab_step "Installing Docker"
      apt-get install -y docker.io curl
      systemctl enable --now docker

      # Published OWASP training apps, unchanged, from their own multi-arch
      # images (arm64 included), pinned by tag. Both are vulnerable on purpose.
      # WebGoat: lessons on :8080/WebGoat, its WebWolf helper on :9090/WebWolf.
      lab_step "Starting WebGoat"
      docker run -d --name webgoat --restart unless-stopped -p 8080:8080 -p 9090:9090 webgoat/webgoat:v2026.5
      # OWASP VulnerableApp listens on 9090 inside its container; published on
      # :9091 so it doesn't clash with WebWolf.
      lab_step "Starting OWASP VulnerableApp"
      docker run -d --name vulnerableapp --restart unless-stopped -p 9091:9090 sasanlabs/owasp-vulnerableapp:2.2.54

      # Both are Java apps that take a minute or two to start: wait, so that
      # "ready" means they answer.
      lab_step "Waiting for the apps to answer"
      for url in http://127.0.0.1:8080/WebGoat/login http://127.0.0.1:9091/VulnerableApp/; do
          for _ in $(seq 1 60); do
              if curl -fsS -o /dev/null --max-time 5 "${url}"; then break; fi
              sleep 5
          done
          curl -fsS -o /dev/null --max-time 5 "${url}" || echo "WARNING: ${url} is not answering yet"
      done

      # --- Wazuh agent: host-level telemetry, only when the lab has a siem. ---
      if [ -n "${WAZUH_MANAGER}" ]; then
          lab_step "Installing the Wazuh agent"
          curl -s https://packages.wazuh.com/key/GPG-KEY-WAZUH | gpg --no-default-keyring --keyring gnupg-ring:/usr/share/keyrings/wazuh.gpg --import
          chmod 644 /usr/share/keyrings/wazuh.gpg
          echo "deb [signed-by=/usr/share/keyrings/wazuh.gpg] https://packages.wazuh.com/4.x/apt/ stable main" > /etc/apt/sources.list.d/wazuh.list
          apt-get update -y
          WAZUH_MANAGER="${WAZUH_MANAGER}" apt-get install -y wazuh-agent
          systemctl daemon-reload
          systemctl enable --now wazuh-agent
      else
          echo "No siem in this lab: Wazuh agent not installed."
      fi

      echo "webtarget2 ready: WebGoat on port 8080 (/WebGoat, register your own"
      echo "account), WebWolf on 9090 (/WebWolf, same account), OWASP VulnerableApp"
      echo "on 9091 (/VulnerableApp, no login)."

runcmd:
  - /root/provision.sh > /var/log/provision.log 2>&1
