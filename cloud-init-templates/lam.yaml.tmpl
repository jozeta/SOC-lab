#cloud-config
hostname: lam
manage_etc_hosts: false
package_update: true
package_upgrade: true     # start patched; deploy-soc-lab.sh reboots if an update needs it

ssh_authorized_keys:
  - __ANSIBLE_PUBKEY__

write_files:
  - path: /root/provision.sh
    permissions: '0o755'   # explicit octal: Multipass turns '0755' into the integer 493, which fails cloud-init's schema
    content: |
      #!/bin/bash
      set -euo pipefail
      lab_step() {   # progress for deploy-soc-lab.sh's panel: "<n> <what>" in /run/lab-progress
          LAB_STEP=$((${LAB_STEP:-0} + 1))
          printf '%s %s\n' "${LAB_STEP}" "$*" > /run/lab-progress
          echo "== step ${LAB_STEP}: $*"
      }
      export DEBIAN_FRONTEND=noninteractive
      WAZUH_MANAGER="__WAZUH_MANAGER_IP__"

      DOMAIN_REALM="__DOMAIN_REALM__"
      DC_IP="__DC_IP__"

      hostnamectl set-hostname lam

      # ldap-account-manager pulls in apache2 + php automatically.
      apt-get update -y
      lab_step "Installing LDAP Account Manager"
      apt-get install -y ldap-account-manager

      systemctl enable --now apache2

      IFS='.' read -ra DC_PARTS <<< "${DOMAIN_REALM,,}"
      BASE_DN=$(printf ",DC=%s" "${DC_PARTS[@]}")
      BASE_DN=${BASE_DN#,}

      # The server profile (LDAPS to dc01, verified against its Samba CA) is
      # written by deploy-soc-lab.sh's test-data stage (seed/labdata.py, role
      # lam), which needs dc01's CA certificate -- not available here yet.
      # --- Wazuh agent: LAM logins (syslog, read from the journal by default) and Apache's access log ---
      lab_step "Installing the Wazuh agent"
      curl -s https://packages.wazuh.com/key/GPG-KEY-WAZUH | gpg --no-default-keyring --keyring gnupg-ring:/usr/share/keyrings/wazuh.gpg --import
      chmod 644 /usr/share/keyrings/wazuh.gpg
      echo "deb [signed-by=/usr/share/keyrings/wazuh.gpg] https://packages.wazuh.com/4.x/apt/ stable main" > /etc/apt/sources.list.d/wazuh.list
      apt-get update -y
      WAZUH_MANAGER="${WAZUH_MANAGER}" apt-get install -y wazuh-agent
      cat >> /var/ossec/etc/ossec.conf <<'EOF'

      <!-- SOC-lab: LDAP Account Manager web access -->
      <ossec_config>
        <localfile>
          <log_format>apache</log_format>
          <location>/var/log/apache2/access.log</location>
        </localfile>
      </ossec_config>
      EOF
      systemctl daemon-reload
      systemctl enable --now wazuh-agent

      echo "=================================================================="
      echo "LDAP Account Manager installed: http://<this-vm-ip>/lam"
      echo "The deploy's test-data stage connects it to ${DOMAIN_REALM,,} over LDAPS"
      echo "(base DN ${BASE_DN}, dc01 at ${DC_IP}); log in as Administrator."
      echo "(LAM's own config-login password, separate from the above, defaults to: lam)"
      echo "=================================================================="

runcmd:
  - /root/provision.sh > /var/log/provision.log 2>&1
