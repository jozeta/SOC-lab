#cloud-config
hostname: velociraptor
manage_etc_hosts: false
package_update: true
package_upgrade: true     # start patched; deploy-soc-lab.sh reboots if an update needs it

ssh_authorized_keys:
  - __ANSIBLE_PUBKEY__

write_files:
  - path: /root/provision.sh
    permissions: '0o755'   # explicit octal: Multipass turns '0755' into the integer 493, which fails cloud-init's schema
    content: |
      #!/bin/bash
      set -euo pipefail
      export DEBIAN_FRONTEND=noninteractive

      ADMIN_PASS="__ADMIN_PASS__"

      hostnamectl set-hostname velociraptor

      apt-get update -y
      apt-get install -y curl

      # Pinned release: the CLI flags used below (config generate --merge,
      # user add --role) were verified against this version. Bump it
      # deliberately and re-check them. Release binaries ship gzipped.
      VELO_VERSION="v0.77.3"
      curl -fsSL -o /tmp/velociraptor.gz \
          "https://github.com/Velocidex/velociraptor/releases/download/${VELO_VERSION}/velociraptor-${VELO_VERSION}-linux-arm64.gz"
      gunzip -c /tmp/velociraptor.gz > /usr/local/bin/velociraptor
      rm -f /tmp/velociraptor.gz
      chmod +x /usr/local/bin/velociraptor

      mkdir -p /etc/velociraptor
      cd /etc/velociraptor
      # The default config binds the GUI to 127.0.0.1 only, which makes it
      # unreachable from the Mac -- bind it to all interfaces (lab NAT only).
      # Clients must connect to this VM's real address, not the default
      # https://localhost:8000/.
      MY_IP=$(ip -o -4 route get 1.1.1.1 | awk '{for (i = 1; i < NF; i++) if ($i == "src") print $(i + 1)}')
      /usr/local/bin/velociraptor config generate \
          --merge "{\"GUI\":{\"bind_address\":\"0.0.0.0\"},\"Client\":{\"server_urls\":[\"https://${MY_IP}:8000/\"]}}" \
          > server.config.yaml
      chmod 600 server.config.yaml

      # Create the GUI admin account (syntax: user add --role=ROLE <user> [<password>]).
      /usr/local/bin/velociraptor --config server.config.yaml user add --role administrator admin "${ADMIN_PASS}"

      cat > /etc/systemd/system/velociraptor.service <<'EOC'
      [Unit]
      Description=Velociraptor Server
      After=network.target

      [Service]
      ExecStart=/usr/local/bin/velociraptor --config /etc/velociraptor/server.config.yaml frontend
      Restart=on-failure

      [Install]
      WantedBy=multi-user.target
      EOC

      systemctl daemon-reload
      systemctl enable --now velociraptor

      # Don't let cloud-init report done until the GUI actually answers.
      for _ in $(seq 1 30); do
          curl -ks -o /dev/null https://127.0.0.1:8889/ && break
          sleep 5
      done
      curl -ks -o /dev/null https://127.0.0.1:8889/ \
          || { echo "ERROR: Velociraptor GUI not answering on 8889"; systemctl status velociraptor --no-pager; exit 1; }

      # Build the endpoint package (a .deb with this server's client config
      # embedded). deploy-soc-lab.sh installs it on dc01, fs01 and the clients.
      /usr/local/bin/velociraptor --config server.config.yaml config client > client.config.yaml
      mkdir -p /opt/velociraptor-pkg
      /usr/local/bin/velociraptor --config client.config.yaml debian client \
          --binary /usr/local/bin/velociraptor --output /opt/velociraptor-pkg/
      chmod 644 /opt/velociraptor-pkg/*.deb

      echo "=================================================================="
      echo "Velociraptor server installed (config: /etc/velociraptor/server.config.yaml)."
      echo "GUI: https://<this-vm-ip>:8889  (admin / the lab admin password)"
      echo "=================================================================="

runcmd:
  - /root/provision.sh > /var/log/provision.log 2>&1
