<!-- SOC-lab detection rules for the Samba AD DC (dc01).
     Each rule is exercised by an attack from redteam (see README). -->
<group name="soc_lab,samba,active_directory,">

  <!-- ===== Kerberos (KDC log) ===== -->
  <rule id="100100" level="0">
    <decoded_as>samba-kdc</decoded_as>
    <field name="kdc_result">^SUCCESS$</field>
    <description>Samba KDC: $(kdc_request) issued for $(kdc_client) -> $(kdc_service)</description>
  </rule>

  <!-- Kerberoasting: a service ticket encrypted with RC4 (etype 23) for a
       non-krbtgt service. Modern clients get AES tickets; RC4 is what
       kerberoasting tools ask for because it cracks fastest. -->
  <rule id="100101" level="10">
    <if_sid>100100</if_sid>
    <field name="kdc_request">^TGS-REQ$</field>
    <field name="kdc_ticket_etype">^23$</field>
    <field name="kdc_service" negate="yes" type="pcre2">^krbtgt/</field>
    <description>Possible Kerberoasting: RC4 service ticket for $(kdc_service) requested by $(kdc_client) from $(kdc_peer)</description>
    <mitre><id>T1558.003</id></mitre>
    <group>kerberoasting,attack,</group>
  </rule>

  <rule id="100102" level="12" frequency="3" timeframe="300">
    <if_matched_sid>100101</if_matched_sid>
    <same_field>kdc_client</same_field>
    <description>Kerberoasting burst: $(kdc_client) requested several RC4 service tickets within 5 minutes</description>
    <mitre><id>T1558.003</id></mitre>
    <group>kerberoasting,attack,</group>
  </rule>

  <!-- AS-REP roasting: a TGT issued without pre-authentication (no "pa="
       in the KDC's success line). Normal logons show pa=ENC-TS. -->
  <rule id="100103" level="10">
    <if_sid>100100</if_sid>
    <field name="kdc_request">^AS-REQ$</field>
    <match negate="yes"> pa=</match>
    <description>Possible AS-REP roasting: TGT for $(kdc_client) issued without pre-authentication to $(kdc_peer)</description>
    <mitre><id>T1558.004</id></mitre>
    <group>asrep_roasting,attack,</group>
  </rule>

  <!-- Wrong password at a Kerberos logon (kinit, workstation logon). The
       simulated staff mistype now and then; many accounts failing from one
       address is Kerberos password spraying (no SMB/NTLM involved). -->
  <rule id="100104" level="3">
    <decoded_as>samba-kdc</decoded_as>
    <field name="kdc_result">^ERR_PREAUTH_FAILED$</field>
    <description>Samba KDC: wrong password (pre-authentication failed) for $(kdc_client) from $(kdc_peer)</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100105" level="10" frequency="5" timeframe="120">
    <if_matched_sid>100104</if_matched_sid>
    <same_field>kdc_peer</same_field>
    <different_field>kdc_client</different_field>
    <description>Possible Kerberos password spraying: pre-authentication failed for 5+ accounts from $(kdc_peer) within 2 minutes</description>
    <mitre><id>T1110.003</id></mitre>
    <group>password_spraying,attack,</group>
  </rule>

  <!-- ===== Authentication (auth_json_audit) ===== -->
  <rule id="100110" level="3">
    <decoded_as>samba-json-auth</decoded_as>
    <field name="auth_status" negate="yes">^NT_STATUS_OK$</field>
    <description>Samba DC: failed $(auth_service) logon for $(auth_user) ($(auth_status)) from $(auth_src)</description>
    <group>authentication_failed,</group>
  </rule>

  <!-- Password spraying: failed logons for several different accounts from
       one source address in a short time. -->
  <rule id="100111" level="10" frequency="5" timeframe="120">
    <if_matched_sid>100110</if_matched_sid>
    <same_field>auth_src</same_field>
    <different_field>auth_user</different_field>
    <description>Possible password spraying: failed logons for 5+ different accounts from $(auth_src) within 2 minutes</description>
    <mitre><id>T1110.003</id></mitre>
    <group>password_spraying,attack,</group>
  </rule>

  <rule id="100112" level="10" frequency="8" timeframe="120">
    <if_matched_sid>100110</if_matched_sid>
    <same_field>auth_user</same_field>
    <description>Possible brute force: 8+ failed logons for $(auth_user) within 2 minutes</description>
    <mitre><id>T1110.001</id></mitre>
    <group>brute_force,attack,</group>
  </rule>

  <!-- ===== Directory changes (dsdb_*_json_audit) ===== -->
  <rule id="100120" level="12">
    <decoded_as>samba-json-audit</decoded_as>
    <field name="type">^groupChange$</field>
    <field name="groupChange.action">^Added$</field>
    <field name="groupChange.group" type="pcre2">(?i)^CN=(Domain Admins|Enterprise Admins|Schema Admins|Administrators),</field>
    <description>Privileged group change: $(groupChange.user) added to $(groupChange.group)</description>
    <mitre><id>T1098</id></mitre>
    <group>account_changed,privilege_escalation,</group>
  </rule>

  <rule id="100121" level="5">
    <decoded_as>samba-json-audit</decoded_as>
    <field name="type">^groupChange$</field>
    <field name="groupChange.action" type="pcre2">^(Added|Removed)$</field>
    <description>AD group membership change: $(groupChange.action) $(groupChange.user) in $(groupChange.group)</description>
    <group>account_changed,</group>
  </rule>

  <rule id="100122" level="8">
    <decoded_as>samba-json-audit</decoded_as>
    <field name="type">^dsdbChange$</field>
    <field name="dsdbChange.operation">^Add$</field>
    <field name="dsdbChange.dn" type="pcre2">^CN=[^,]+,(CN=Users|OU=)</field>
    <description>New AD object created: $(dsdbChange.dn)</description>
    <mitre><id>T1136.002</id></mitre>
    <group>account_changed,</group>
  </rule>

  <rule id="100123" level="8">
    <decoded_as>samba-json-audit</decoded_as>
    <field name="type">^passwordChange$</field>
    <field name="passwordChange.action">^Reset$</field>
    <description>AD password reset by another account: $(passwordChange.dn)</description>
    <mitre><id>T1098</id></mitre>
    <group>account_changed,</group>
  </rule>

</group>

<!-- ===== Network (Suricata on sensor, via Wazuh's built-in 86601) ===== -->
<group name="soc_lab,suricata,ids,">

  <!-- Noise in this lab: package-manager traffic and ICMP oddities. -->
  <rule id="100130" level="0">
    <if_sid>86601</if_sid>
    <field name="alert.signature" type="pcre2">^(ET INFO .*APT User-Agent|SURICATA ICMPv4 unknown code)</field>
    <description>Suricata: ignored lab noise ($(alert.signature))</description>
  </rule>

  <rule id="100131" level="8">
    <if_sid>86601</if_sid>
    <field name="alert.signature" type="pcre2">^ET SCAN </field>
    <description>Network scan from $(src_ip) to $(dest_ip):$(dest_port): $(alert.signature)</description>
    <mitre><id>T1046</id></mitre>
    <group>recon,attack,</group>
  </rule>

  <rule id="100132" level="10" frequency="4" timeframe="120">
    <if_matched_sid>100131</if_matched_sid>
    <same_field>src_ip</same_field>
    <description>Port scan: 4+ scan signatures from $(src_ip) within 2 minutes</description>
    <mitre><id>T1046</id></mitre>
    <group>recon,attack,</group>
  </rule>

</group>

<!-- ===== CI/CD (gitea hook, pipeline events, prod deploys and containers) ===== -->
<group name="soc_lab,cicd,">

  <rule id="100140" level="3">
    <decoded_as>json</decoded_as>
    <field name="lab_source">^gitea-hook$</field>
    <description>Git $(event) to $(repo) $(ref) by $(pusher)</description>
  </rule>

  <!-- Poisoned pipeline execution starts with editing the pipeline itself. -->
  <rule id="100141" level="10">
    <if_sid>100140</if_sid>
    <field name="workflow_changed">^true$</field>
    <description>CI/CD pipeline definition changed in $(repo) by $(pusher): $(workflow_files)</description>
    <mitre><id>T1195.002</id></mitre>
    <group>supply_chain,attack,</group>
  </rule>

  <rule id="100142" level="10">
    <if_sid>100140</if_sid>
    <field name="event">^force_push$</field>
    <description>Force push rewrote history on $(repo) $(ref) (by $(pusher))</description>
    <mitre><id>T1195.002</id></mitre>
    <group>supply_chain,attack,</group>
  </rule>

  <rule id="100143" level="5">
    <decoded_as>json</decoded_as>
    <field name="lab_source">^cicd-pipeline$</field>
    <field name="event" type="pcre2">^(gate_failed|deploy_failed)$</field>
    <description>CI/CD $(event): $(detail) for $(repo)@$(sha) (pushed by $(actor))</description>
    <group>cicd_gate,</group>
  </rule>

  <rule id="100144" level="3">
    <decoded_as>json</decoded_as>
    <field name="lab_source">^cicd-pipeline$</field>
    <field name="event" type="pcre2">^(image_pushed|deployed)$</field>
    <description>CI/CD $(event): $(detail)</description>
  </rule>

  <rule id="100145" level="12">
    <decoded_as>json</decoded_as>
    <field name="lab_source">^prod-deploy$</field>
    <field name="event">^deploy_rejected$</field>
    <description>prod rejected a deploy of an unapproved image from $(client): $(image)</description>
    <mitre><id>T1610</id></mitre>
    <group>supply_chain,attack,</group>
  </rule>

  <rule id="100146" level="3">
    <decoded_as>json</decoded_as>
    <field name="lab_source">^prod-deploy$</field>
    <field name="event">^deployed$</field>
    <description>prod deployed $(image)</description>
  </rule>

  <!-- Anything started on prod that isn't a build from the lab registry
       bypassed the pipeline (e.g. a manual `docker run`). -->
  <rule id="100147" level="12">
    <decoded_as>json</decoded_as>
    <field name="Type">^container$</field>
    <!-- The decoder keeps Docker's key as "Action", but rules can't name it
         (Wazuh treats it as its static "action" field), so match the text. -->
    <match>"Action":"start"</match>
    <field name="Actor.Attributes.image" negate="yes" type="pcre2">^\d+\.\d+\.\d+\.\d+:3000/labadmin/</field>
    <description>Container started outside the pipeline: $(Actor.Attributes.image) as $(Actor.Attributes.name)</description>
    <mitre><id>T1610</id></mitre>
    <group>supply_chain,attack,</group>
  </rule>

</group>

<!-- ===== Web apps: Uptime Kuma, LDAP Account Manager, Semaphore ===== -->
<group name="soc_lab,webapps,">

  <rule id="100160" level="3">
    <decoded_as>uptime-kuma</decoded_as>
    <field name="kuma_result">^Successfully logged in$</field>
    <description>Uptime Kuma: $(kuma_user) logged in from $(kuma_src)</description>
    <group>authentication_success,</group>
  </rule>

  <rule id="100161" level="5">
    <decoded_as>uptime-kuma</decoded_as>
    <field name="kuma_result">^Incorrect username or password for$</field>
    <description>Uptime Kuma: failed login for $(kuma_user) from $(kuma_src)</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100162" level="10" frequency="6" timeframe="120">
    <if_matched_sid>100161</if_matched_sid>
    <same_field>kuma_src</same_field>
    <description>Possible brute force on Uptime Kuma: 6+ failed logins from $(kuma_src) within 2 minutes</description>
    <mitre><id>T1110.001</id></mitre>
    <group>brute_force,attack,</group>
  </rule>

  <rule id="100163" level="7">
    <decoded_as>uptime-kuma</decoded_as>
    <field name="kuma_state">^Failing$</field>
    <description>Uptime Kuma: '$(kuma_monitor)' is down: $(kuma_error)</description>
    <group>availability,</group>
  </rule>

  <!-- LAM lines are decoded as apache-errorlog (see the decoder), so these
       hang under Wazuh's "Apache: Messages grouped" rule. -->
  <rule id="100170" level="3">
    <if_sid>30100</if_sid>
    <field name="lam_result">^successfully logged in$</field>
    <description>LDAP Account Manager: $(lam_user) logged in from $(lam_src)</description>
    <group>authentication_success,</group>
  </rule>

  <rule id="100171" level="5">
    <if_sid>30100</if_sid>
    <field name="lam_result">^failed to log in$</field>
    <description>LDAP Account Manager: failed login for $(lam_user) from $(lam_src)</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100172" level="10" frequency="6" timeframe="120">
    <if_matched_sid>100171</if_matched_sid>
    <same_field>lam_src</same_field>
    <description>Possible brute force on LDAP Account Manager: 6+ failed logins from $(lam_src) within 2 minutes</description>
    <mitre><id>T1110.001</id></mitre>
    <group>brute_force,attack,</group>
  </rule>

  <!-- Only Administrator and IT staff (OU=IT) manage accounts here. -->
  <rule id="100173" level="10">
    <if_sid>100170</if_sid>
    <field name="lam_user" negate="yes" type="pcre2">(?i)^(?:CN=[^,]+,OU=IT,|cn=Administrator,cn=Users,)</field>
    <description>LDAP Account Manager: login by $(lam_user), which is not an IT account, from $(lam_src)</description>
    <mitre><id>T1078.002</id></mitre>
    <group>account_misuse,attack,</group>
  </rule>

  <rule id="100180" level="3">
    <decoded_as>semaphore</decoded_as>
    <field name="semaphore_msg">^Task started$</field>
    <description>Semaphore: task '$(semaphore_task)' started</description>
  </rule>

  <rule id="100181" level="5">
    <decoded_as>semaphore</decoded_as>
    <field name="semaphore_msg">^Failed to run task$</field>
    <description>Semaphore: task $(semaphore_task_id) failed: $(semaphore_error)</description>
    <group>automation_failed,</group>
  </rule>

</group>

<!-- ===== Web proxy (Squid on sensor) ===== -->
<group name="soc_lab,squid,web_proxy,">

  <!-- Wazuh's own Squid rules only alert on 4xx/5xx; successful requests stop
       at level 0 (35000). Keep them, so browsing per client can be searched
       and charted (the lab's traffic is small). -->
  <rule id="100190" level="3">
    <if_sid>35000</if_sid>
    <id>^2|^3</id>
    <description>Proxy: $(srcip) $(action) $(url)</description>
    <group>web_access,</group>
  </rule>

</group>

<!-- ===== Deception (OpenCanary on honeypot) ===== -->
<group name="soc_lab,honeypot,">

  <!-- Log types 1000-1999 are OpenCanary's own status messages; 2000+ are
       interactions with a fake service. Nothing legitimate uses them. -->
  <rule id="100150" level="10">
    <decoded_as>json</decoded_as>
    <field name="node_id">^honeypot$</field>
    <field name="logtype" type="pcre2">^[2-9]\d{3}$</field>
    <description>Honeypot touched: $(src_host) -> port $(dst_port) (OpenCanary log type $(logtype))</description>
    <mitre><id>T1046</id></mitre>
    <group>deception,attack,</group>
  </rule>

  <rule id="100151" level="12">
    <if_sid>100150</if_sid>
    <field name="logdata.USERNAME" type="pcre2">.</field>
    <description>Honeypot login attempt from $(src_host) on port $(dst_port) as "$(logdata.USERNAME)"</description>
    <mitre><id>T1110</id></mitre>
    <group>deception,attack,</group>
  </rule>

</group>
