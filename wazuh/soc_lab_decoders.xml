<!-- SOC-lab: Samba AD DC (dc01) logs. Samba writes "debug syslog format"
     lines for Kerberos (program samba) and bare JSON audit events
     (auth_json_audit, dsdb_json_audit, dsdb_group_json_audit). -->

<!-- Kerberos KDC messages: "... samba[pid]:   Kerberos: AS-REQ SUCCESS ..." -->
<decoder name="samba-kdc">
  <program_name>^samba$</program_name>
  <prematch>Kerberos: </prematch>
</decoder>

<decoder name="samba-kdc-result">
  <parent>samba-kdc</parent>
  <regex type="pcre2">Kerberos: ((?:AS|TGS)-REQ) (\S+) (\S+?):(\d+) (\S+)@\S+ (\S+) </regex>
  <order>kdc_request, kdc_result, kdc_peer, kdc_port, kdc_client, kdc_service</order>
</decoder>

<decoder name="samba-kdc-result">
  <parent>samba-kdc</parent>
  <regex type="pcre2"> etype=(\d+)/(\d+)</regex>
  <order>kdc_reply_etype, kdc_ticket_etype</order>
</decoder>

<!-- Authentication events (auth_json_audit), decoded with a regex so the
     source IP comes without the per-connection port (needed to correlate
     password spraying by source). Samba emits the keys in a fixed order. -->
<decoder name="samba-json-auth">
  <prematch type="pcre2">^\s*\{"timestamp": "[^"]+", "type": "Authentication"</prematch>
  <regex type="pcre2">"eventId": (\d+), .*?"status": "([^"]+)", .*?"remoteAddress": "ipv[46]:(.+?):\d+", "serviceDescription": "([^"]*)", "authDescription": "([^"]*)", "clientDomain": "([^"]*)", "clientAccount": "([^"]*)"</regex>
  <order>auth_event_id, auth_status, auth_src, auth_service, auth_method, auth_domain, auth_user</order>
</decoder>

<!-- Directory change events (dsdb_json_audit, dsdb_group_json_audit). -->
<decoder name="samba-json-audit">
  <prematch type="pcre2">^\s*\{"timestamp": "[^"]+", "type": "(?:dsdbChange|groupChange|passwordChange)"</prematch>
  <plugin_decoder>JSON_Decoder</plugin_decoder>
</decoder>

<!-- ===== Web apps (mgmt, lam) ===== -->

<!-- Uptime Kuma (mgmt, /var/log/lab-apps/uptime-kuma.log):
     "2026-11-04T16:48:51Z [AUTH] WARN: Incorrect username or password for user admin. IP=192.168.252.165"
     "2026-11-04T16:48:54Z [MONITOR] WARN: Monitor #8 'Velociraptor': Failing: Request failed ... | Interval: 60 seconds" -->
<decoder name="uptime-kuma">
  <prematch type="pcre2">\[(?:AUTH|MONITOR)\] (?:INFO|WARN|ERROR): </prematch>
</decoder>

<decoder name="uptime-kuma-fields">
  <parent>uptime-kuma</parent>
  <regex type="pcre2">\[AUTH\] \w+: (Successfully logged in|Incorrect username or password for) user (\S+?)\. IP=(\S+)</regex>
  <order>kuma_result, kuma_user, kuma_src</order>
</decoder>

<decoder name="uptime-kuma-fields">
  <parent>uptime-kuma</parent>
  <regex type="pcre2">\[MONITOR\] WARN: Monitor #\d+ '([^']+)': (Failing|Pending): (.+?)(?: \| |$)</regex>
  <order>kuma_monitor, kuma_state, kuma_error</order>
</decoder>

<!-- LDAP Account Manager (lam): syslog via the journal, program apache2, so
     Wazuh's own apache-errorlog decoder claims the line first; this is its child.
     "LDAP Account Manager (<session> - <ip> - <dn>) - NOTICE: User <dn> (<ip>) successfully logged in."
     "... - ERROR: User <dn> (<ip>) failed to log in (wrong password). LDAP error, ..." -->
<decoder name="lam-login">
  <parent>apache-errorlog</parent>
  <prematch>^LDAP Account Manager \(</prematch>
  <regex type="pcre2">- (?:NOTICE|ERROR): User (.+?) \((\S+)\) (successfully logged in|failed to log in)</regex>
  <order>lam_user, lam_src, lam_result</order>
</decoder>

<!-- Semaphore (mgmt, /var/log/lab-apps/semaphore.log): logrus lines. The
     copier (lab-container-log@) drops the leading time="..." -- with it, Wazuh's
     aws-eks-authenticator decoder would claim every line.
     level=warning msg="Failed to run task" context=task_runner error="exit status 4" task_id=1 -->
<decoder name="semaphore">
  <prematch type="pcre2">^level=\w+ msg="</prematch>
  <regex type="pcre2">^level=(\w+) msg="([^"]+)"(?:.*? error="([^"]*)")?(?:.*? task_id=(\d+))?(?:.*? task_name="([^"]*)")?</regex>
  <order>semaphore_level, semaphore_msg, semaphore_error, semaphore_task_id, semaphore_task</order>
</decoder>
